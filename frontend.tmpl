{{define "frontend"}}<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>CrossBoard</title>
    <style>
      :root {
        --bg: #0a0f1e;
        --bg2: #0e1628;
        --panel: #111a30;
        --panel2: #16213c;
        --line: #22304f;
        --line2: #2b3c63;
        --text: #dce5f6;
        --muted: #8aa0c4;
        --dim: #5c7197;
        --accent: #38bdf8;
        --violet: #a78bfa;
        --blue: #60a5fa;
        --teal: #2dd4bf;
        --ok: #34d399;
        --warn: #fbbf24;
        --red: #f87171;
        --amber: #f59e0b;
        --sky: #7dd3fc;
        --mono:
          ui-monospace, "Cascadia Code", "JetBrains Mono", Menlo, Consolas,
          "Courier New", monospace;
        --tsw: 29ch;
        --sans:
          system-ui, -apple-system, "Segoe UI", Roboto, "Inter", sans-serif;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
      }
      body {
        background:
          radial-gradient(
            1100px 520px at 85% -10%,
            rgba(56, 189, 248, 0.09),
            transparent 60%
          ),
          radial-gradient(
            900px 480px at -10% 0%,
            rgba(167, 139, 250, 0.09),
            transparent 55%
          ),
          var(--bg);
        color: var(--text);
        font: 14px/1.45 var(--sans);
        padding-bottom: 40px;
      }
      a {
        color: var(--accent);
      }
      .hidden {
        display: none !important;
      }

      /* ---------- header ---------- */
      header {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        padding: 18px 22px;
        border-bottom: 1px solid var(--line);
        background: rgba(10, 15, 30, 0.75);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 40;
      }
      .logo {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--accent), var(--violet));
        display: grid;
        place-items: center;
        font-size: 21px;
        font-weight: 900;
        letter-spacing: -0.5px;
        line-height: 1;
        color: #08111f;
      }
      header h1 {
        font-size: 20px;
        margin: 0;
        letter-spacing: 0.3px;
      }
      .updated {
        margin-left: auto;
        color: var(--text);
        font-size: 12px;
        white-space: nowrap;
        font-family: var(--mono);
        border-radius: 999px;
        padding: 5px 14px;
        border: 1px solid var(--line);
        background: var(--bg2);
      }
      .auto {
        display: flex;
        gap: 8px;
        align-items: center;
      }
      .auto button {
        white-space: nowrap;
        font-size: 12px;
        padding: 7px 12px;
      }
      .auto button.on {
        background: var(--ok);
        border-color: var(--ok);
        color: #08111f;
        font-weight: 600;
      }
      .auto button.on:hover {
        filter: brightness(1.12);
      }
      .auto button:not(.on):hover {
        border-color: var(--ok);
        background: rgba(52, 211, 153, 0.15);
      }
      .auto select {
        max-width: 110px;
        padding: 7px 8px;
      }

      /* ---------- banner ---------- */
      .banner {
        margin: 16px 22px 0;
        padding: 10px 14px;
        border: 1px solid rgba(248, 113, 113, 0.4);
        background: rgba(248, 113, 113, 0.1);
        color: #fecaca;
        border-radius: 10px;
        font-size: 13px;
        white-space: pre-wrap;
        word-break: break-word;
      }

      /* ---------- cards ---------- */
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
        gap: 12px;
        padding: 16px 22px 6px;
        max-width: 1600px;
        margin: 0 auto;
      }
      .cards.row2 {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        padding: 6px 22px 16px;
      }
      .card {
        position: relative;
        background: linear-gradient(180deg, var(--panel), var(--panel2));
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 12px 14px 11px;
        overflow: hidden;
      }
      .card[data-scope] {
        cursor: pointer;
        transition:
          transform 0.12s ease,
          border-color 0.12s ease;
      }
      .card[data-scope]:hover {
        transform: translateY(-2px);
        border-color: var(--cc);
      }
      .card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 4px;
        background: var(--cc);
      }
      .card .label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--muted);
      }
      .card .value {
        font-size: 28px;
        font-weight: 700;
        line-height: 1.15;
        color: var(--cc);
        font-family: var(--mono);
      }
      .card.accent {
        --cc: var(--accent);
      }
      .card.violet {
        --cc: var(--violet);
      }
      .card.blue {
        --cc: var(--blue);
      }
      .card.teal {
        --cc: var(--teal);
      }
      .card.ok {
        --cc: var(--ok);
      }
      .card.red {
        --cc: var(--red);
      }
      .card.amber {
        --cc: var(--amber);
      }
      .card.redSoft {
        --cc: var(--red);
      }
      .card.sky {
        --cc: var(--sky);
      }

      /* ---------- toolbar ---------- */
      .toolbar {
        max-width: 1600px;
        margin: 6px auto 0;
        padding: 0 22px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
      }
      .search-wrap {
        position: relative;
        flex: 1 1 320px;
        min-width: 240px;
      }
      .search-wrap input {
        width: 100%;
        padding: 10px 34px 10px 12px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--text);
        font-size: 14px;
        outline: none;
      }
      .search-wrap input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
      }
      .search-wrap .ico {
        position: absolute;
        right: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--dim);
        pointer-events: none;
      }
      select {
        padding: 9px 10px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--text);
        font-size: 13px;
        outline: none;
        max-width: 220px;
      }
      select:focus {
        border-color: var(--accent);
      }
      .actions {
        margin-left: auto;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }
      button {
        font: inherit;
        cursor: pointer;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--text);
        padding: 9px 14px;
        transition: all 0.15s;
      }
      button:hover {
        border-color: var(--line2);
        background: var(--panel2);
      }
      button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
      button.primary {
        background: var(--accent);
        border-color: var(--accent);
        color: #08111f;
        font-weight: 600;
      }
      button.primary:hover {
        filter: brightness(1.12);
      }

      /* ---------- table ---------- */
      .tablewrap {
        max-width: 1600px;
        margin: 14px auto 0;
        padding: 0 22px;
      }
      .panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
      }
      .table-scroll {
        overflow: auto;
        max-height: calc(100vh - 320px);
        min-height: 160px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        white-space: nowrap;
      }
      thead th {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #0d1527;
        color: var(--muted);
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
        text-align: left;
        padding: 9px 10px;
        border-bottom: 1px solid var(--line2);
        user-select: none;
      }
      thead th[data-key] {
        cursor: pointer;
      }
      thead th[data-key]:hover {
        color: var(--text);
      }
      thead th.sorted {
        color: var(--accent);
      }
      thead th.sorted.asc::after {
        content: "\25B2";
        opacity: 1;
      }
      thead th.sorted.desc::after {
        content: "\25BC";
        opacity: 1;
      }
      tbody td {
        padding: 8px 10px;
        border-bottom: 1px solid rgba(34, 48, 79, 0.55);
        vertical-align: middle;
      }
      tbody tr:hover {
        background: rgba(56, 189, 248, 0.045);
        cursor: pointer;
      }
      tbody tr.row-on td {
        background: rgba(56, 189, 248, 0.1);
      }
      tfoot td {
        position: sticky;
        bottom: 0;
        z-index: 9;
        background: #0d1527;
        color: var(--dim);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 8px 10px;
        border-top: 1px solid var(--line2);
      }
      tfoot td.sel {
        color: var(--accent);
        text-align: center;
        font-weight: 700;
        font-family: var(--mono);
      }
      .col-chk {
        width: 34px;
        text-align: center;
      }
      td.chk {
        text-align: center;
      }
      input[type="checkbox"] {
        accent-color: var(--accent);
      }
      .badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        border: 1px solid transparent;
      }
      .badge.ok {
        background: rgba(52, 211, 153, 0.12);
        color: var(--ok);
        border-color: rgba(52, 211, 153, 0.35);
      }
      .badge.warn {
        background: rgba(251, 191, 36, 0.12);
        color: var(--warn);
        border-color: rgba(251, 191, 36, 0.35);
      }
      .badge.blue {
        background: rgba(96, 165, 250, 0.12);
        color: var(--blue);
        border-color: rgba(96, 165, 250, 0.35);
      }
      .badge.err {
        background: rgba(248, 113, 113, 0.12);
        color: var(--red);
        border-color: rgba(248, 113, 113, 0.35);
      }
      .badge.unk {
        background: rgba(148, 163, 184, 0.12);
        color: var(--muted);
        border-color: rgba(148, 163, 184, 0.35);
      }
      .badge.muted {
        background: transparent;
        color: var(--dim);
        border-color: var(--line);
      }
      .badge.yes {
        background: rgba(52, 211, 153, 0.15);
        color: var(--ok);
      }
      .badge.no {
        background: rgba(248, 113, 113, 0.15);
        color: var(--red);
      }
      td.ctx {
        color: var(--accent);
        font-family: var(--mono);
        font-size: 12px;
      }
      td.ns {
        color: var(--text);
      }
      td.pod {
        color: #c9d6ee;
        font-family: var(--mono);
      }
      td.cont {
        color: var(--teal);
        font-family: var(--mono);
      }
      td.node {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 12px;
      }
      td.qos {
        color: var(--violet);
        font-size: 12px;
      }
      td.labels {
        max-width: 240px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--muted);
        font-size: 12px;
      }
      td.cpu {
        max-width: 130px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--dim);
        font-size: 12px;
        font-family: var(--mono);
      }
      td.mem {
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--dim);
        font-size: 12px;
        font-family: var(--mono);
      }
      td.created {
        color: var(--dim);
        font-size: 12px;
        font-family: var(--mono);
      }
      .empty {
        padding: 36px;
        text-align: center;
        color: var(--dim);
      }

      /* ---------- resource browser ---------- */
      .spec-wrap {
        display: flex;
        flex: 1;
        min-height: 0;
      }
      .spec-meta {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px 20px;
        flex-wrap: wrap;
        padding: 8px 16px;
        border-bottom: 1px solid var(--line);
        background: var(--panel);
        font-size: 12px;
        color: var(--muted);
      }
      .spec-meta b {
        color: var(--text);
        font-weight: 600;
      }
      .spec-meta .labs {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 6px;
        align-items: center;
        font-family: var(--mono);
        font-size: 11px;
        max-width: 100%;
      }
      .lchip {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 1px 9px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--bg2);
        white-space: nowrap;
      }
      .lchip .lk {
        color: var(--teal);
      }
      .lchip .lv {
        color: #ffc87a;
      }
      .lchip .eq {
        color: var(--dim);
      }
      .spec-meta code {
        background: rgba(56, 189, 248, 0.08);
        padding: 1px 6px;
        border-radius: 6px;
      }
      .spec-list {
        flex: 0 0 270px;
        max-width: 310px;
        display: flex;
        flex-direction: column;
        min-height: 0;
        border-right: 1px solid var(--line);
        background: var(--panel);
      }
      .spec-tools {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 10px;
        border-bottom: 1px solid var(--line);
      }
      .spec-tools select {
        width: 100%;
        max-width: none;
      }
      .spec-tools input[type="search"] {
        width: 100%;
        padding: 7px 10px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: var(--bg2);
        color: var(--text);
        font-size: 12px;
        outline: none;
        box-sizing: border-box;
      }
      .spec-tools input[type="search"]:focus {
        border-color: var(--accent);
      }
      .spec-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .chip {
        padding: 2px 9px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--bg2);
        color: var(--muted);
        font-size: 11px;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
      }
      .chip:hover {
        border-color: var(--accent);
      }
      .chip.on {
        background: rgba(56, 189, 248, 0.14);
        color: var(--accent);
        border-color: var(--accent);
      }
      .chip .n {
        opacity: 0.6;
        margin-left: 4px;
      }
      .spec-items {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
      }
      .spec-cat {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--dim);
        margin: 10px 2px 4px;
        white-space: nowrap;
      }
      .spec-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1px;
        width: 100%;
        text-align: left;
        padding: 6px 8px;
        margin: 2px 0;
        border-radius: 8px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text);
        font-size: 12px;
      }
      .spec-item:hover {
        background: rgba(56, 189, 248, 0.08);
      }
      .spec-item.active {
        background: rgba(56, 189, 248, 0.12);
        border-color: var(--accent);
      }
      .spec-kind {
        flex: 0 0 auto;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: var(--accent);
        font-family: var(--mono);
      }
      .spec-item .nm {
        flex: 0 1 auto;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .spec-item .sns {
        flex: 0 0 auto;
        font-size: 10px;
        color: var(--dim);
        font-family: var(--mono);
        white-space: nowrap;
      }
      .spec-item .scx {
        flex: 0 0 auto;
        font-size: 10px;
        color: var(--violet);
        font-family: var(--mono);
        white-space: nowrap;
        background: rgba(167, 139, 250, 0.1);
        padding: 0 6px;
        border-radius: 999px;
        margin-top: 2px;
      }
      .spec-item .age {
        flex: 0 0 auto;
        font-size: 10px;
        color: var(--dim);
        font-family: var(--mono);
        white-space: nowrap;
        margin-top: 2px;
      }
      .spec-item .reason {
        flex: 0 0 auto;
        font-size: 10px;
        color: var(--dim);
        font-family: var(--mono);
        white-space: nowrap;
        margin-top: 2px;
      }
      .search-stat {
        font-size: 10px;
        color: var(--dim);
        font-family: var(--mono);
        min-height: 12px;
      }
      .search-stat.hit {
        color: var(--accent);
      }
      .spec-body {
        flex: 1;
        overflow: auto;
        padding: 14px 18px;
        margin: 0;
        font-family: var(--mono);
        font-size: 12px;
        line-height: 1.55;
        color: #cdd9f0;
        white-space: pre-wrap;
        word-break: break-word;
        background: #070c19;
      }
      .spec-body.error {
        color: var(--red);
      }

      /* ---------- modal ---------- */
      .modal {
        position: fixed;
        inset: 0;
        z-index: 50;
        background: rgba(5, 9, 18, 0.72);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: stretch;
        justify-content: center;
        padding: 14px;
      }
      .modal-window {
        display: flex;
        flex-direction: column;
        width: min(1350px, 100%);
        height: 100%;
        background: var(--bg2);
        border: 1px solid var(--line2);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
      }
      .modal-head {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding: 12px 16px;
        border-bottom: 1px solid var(--line);
        background: var(--panel);
      }
      .modal-head h2 {
        margin: 0;
        font-size: 16px;
        white-space: nowrap;
      }
      .modal-head h2 span {
        color: var(--accent);
        font-family: var(--mono);
        font-weight: 600;
      }
      .modal-close {
        margin-left: auto;
        flex: 0 0 auto;
        align-self: center;
        padding: 8px 13px;
        font-size: 14px;
        line-height: 1;
        border-radius: 10px;
        color: var(--muted);
      }
      .modal-close:hover {
        border-color: var(--red);
        background: rgba(248, 113, 113, 0.12);
        color: #f87171;
      }
      .modal-tools {
        margin-left: auto;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
        flex: 1 1 auto;
        min-width: 0;
      }
      .mt-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .mt-row button,
      .mt-row select {
        flex: 0 0 auto;
        height: 34px;
        box-sizing: border-box;
        padding: 0 12px;
        font-size: 12px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .mt-row select {
        padding: 0 10px;
        font-family: var(--sans);
      }
      .tgl {
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 9px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--text);
        white-space: nowrap;
        font-weight: 600;
      }
      .tgl:hover {
        border-color: var(--warn);
      }
      .tgl.on {
        background: var(--warn);
        border-color: var(--warn);
        color: #1a1204;
        box-shadow: 0 0 12px rgba(251, 191, 36, 0.45);
      }
      .modal-tools input[type="search"] {
        padding: 8px 10px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: var(--bg2);
        color: var(--text);
        font-size: 13px;
        outline: none;
        width: 240px;
      }
      .modal-tools input[type="search"]:focus {
        border-color: var(--accent);
      }
      .modal-tools input[type="search"].re {
        border-color: var(--red);
        color: var(--red);
      }
      .seg {
        position: relative;
        display: flex;
        align-items: center;
        border: 1px solid var(--line);
        border-radius: 9px;
        overflow: hidden;
        background: var(--bg2);
      }
      .seg-btn {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        padding: 5px 8px;
        color: var(--muted);
        font-size: 12px;
        cursor: pointer;
        user-select: none;
        transition: color 0.15s;
      }
      .seg-btn span {
        pointer-events: none;
      }
      .seg-btn input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
      }
      .seg-btn:has(input:checked) {
        color: #08111f;
        font-weight: 700;
      }
      .seg-thumb {
        position: absolute;
        top: 1px;
        bottom: 1px;
        left: 0;
        width: 58px;
        background: var(--accent);
        border-radius: 4px;
        transition: left 0.18s ease;
      }
      #modeSeg:has(.seg-btn:nth-child(1) input:checked) .seg-thumb {
        left: 0;
        border-radius: 8px 4px 4px 8px;
      }
      #modeSeg:has(.seg-btn:nth-child(2) input:checked) .seg-thumb {
        left: 58px;
        border-radius: 4px;
      }
      #modeSeg:has(.seg-btn:nth-child(3) input:checked) .seg-thumb {
        left: 116px;
        border-radius: 4px;
      }
      #modeSeg:has(.seg-btn:nth-child(4) input:checked) .seg-thumb {
        left: 174px;
        border-radius: 4px 8px 8px 4px;
      }
      .sw {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--muted);
        font-size: 12px;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
      }
      .sw input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
      }
      .sw .trk {
        position: relative;
        flex: 0 0 auto;
        width: 30px;
        height: 17px;
        border-radius: 999px;
        background: var(--line);
        transition: background 0.15s;
      }
      .sw .trk::after {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: #c7d4ea;
        transition:
          left 0.15s,
          background 0.15s;
      }
      .sw input:checked + .trk {
        background: var(--accent);
      }
      .sw input:checked + .trk::after {
        left: 15px;
        background: #08111f;
      }
      .conn {
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        border-radius: 999px;
        padding: 5px 12px;
        border: 1px solid var(--line);
        background: var(--bg2);
      }
      .conn.on {
        color: var(--ok);
        border-color: rgba(52, 211, 153, 0.35);
        background: rgba(52, 211, 153, 0.08);
      }
      .conn.off {
        color: var(--red);
        border-color: rgba(248, 113, 113, 0.35);
        background: rgba(248, 113, 113, 0.08);
      }
      .conn.wait {
        color: var(--warn);
        border-color: rgba(251, 191, 36, 0.35);
        background: rgba(251, 191, 36, 0.08);
      }
      .conn.done {
        color: var(--accent);
        border-color: rgba(56, 189, 248, 0.35);
        background: rgba(56, 189, 248, 0.08);
      }
      .count {
        font-size: 12px;
        color: var(--text);
        font-family: var(--mono);
        white-space: nowrap;
        border-radius: 999px;
        padding: 5px 12px;
        border: 1px solid var(--line);
        background: var(--bg2);
      }
      #eventsModal .tablewrap {
        width: 100%;
        max-width: none;
      }
      #eventsModal #evFilter {
        width: 240px;
        flex: 0 0 auto;
      }
      #eventsModal #evCtx {
        width: auto;
        max-width: none;
      }
      #eventsModal #evTypeSeg {
        flex: 0 0 auto;
      }
      #evTypeSeg:has(.seg-btn:nth-child(1) input:checked) .seg-thumb {
        left: 0;
        border-radius: 8px 4px 4px 8px;
      }
      #evTypeSeg:has(.seg-btn:nth-child(2) input:checked) .seg-thumb {
        left: 58px;
        border-radius: 4px;
      }
      #evTypeSeg:has(.seg-btn:nth-child(3) input:checked) .seg-thumb {
        left: 116px;
        border-radius: 4px 8px 8px 4px;
      }
      #eventsModal .table-scroll table {
        width: auto;
        min-width: 100%;
        table-layout: auto;
      }
      #eventsModal .table-scroll th:not(.msg),
      #eventsModal .table-scroll td:not(.msg) {
        white-space: nowrap;
      }
      #eventsModal .table-scroll th.msg,
      #eventsModal .table-scroll td.msg {
        white-space: normal;
        word-break: break-word;
        width: 100%;
        min-width: 0;
      }
      #eventsModal .table-scroll.no-wrap table td.msg,
      #eventsModal .table-scroll.no-wrap table th.msg {
        white-space: nowrap;
        word-break: normal;
      }
      #eventsModal .table-scroll.no-wrap table {
        width: 100%;
        min-width: 1200px;
      }
      .log-body {
        flex: 1;
        overflow-y: auto;
        padding: 8px 0;
        font-family: var(--mono);
        font-size: 12.5px;
        line-height: 1.5;
        background: #070c19;
        --ctxw: 9ch;
        --podw: 16ch;
      }
      .log-body.no-wrap {
        overflow-x: auto;
      }
      .log-body.no-wrap .logline {
        min-width: max-content;
      }
      .log-body.no-wrap .lb-msg {
        white-space: pre;
        word-break: normal;
      }
      .log-body.no-ts .lb-time {
        display: none;
      }
      .logline {
        display: flex;
        gap: 10px;
        padding: 1px 14px;
        border-bottom: 1px solid rgba(34, 48, 79, 0.18);
      }
      .logline:hover {
        background: rgba(56, 189, 248, 0.05);
        cursor: pointer;
      }
      .logline.hide {
        display: none;
      }
      .logline.logerr {
        background: rgba(248, 113, 113, 0.08);
      }
      .logline.logerr.ctx {
        background: rgba(248, 113, 113, 0.045);
      }
      .logline.ctx {
        background: rgba(56, 189, 248, 0.045);
        opacity: 0.8;
      }
      .lb-badge {
        flex: 0 0 auto;
        min-width: var(--ctxw);
        max-width: var(--ctxw);
        color: var(--accent);
        font-size: 11px;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .lb-time {
        flex: 0 0 auto;
        width: var(--tsw);
        color: var(--dim);
        font-size: 11px;
        white-space: nowrap;
        overflow: hidden;
      }
      .lb-where {
        flex: 0 0 auto;
        min-width: var(--podw);
        max-width: var(--podw);
        color: var(--teal);
        font-size: 11px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .lb-msg {
        white-space: pre-wrap;
        word-break: break-word;
        color: #cdd9f0;
        flex: 1;
      }
      .lb-msg mark {
        background: var(--warn);
        color: #1a1204;
        border-radius: 3px;
        padding: 0 2px;
      }
      .spec-body mark {
        background: var(--warn);
        color: #1a1204;
        border-radius: 2px;
        padding: 0 1px;
      }
      .spec-body .y-k {
        color: #2dd4bf;
      }
      .spec-body .y-v {
        color: var(--text);
      }
      .spec-body .y-q {
        color: #7ee2a8;
      }
      .spec-body .y-n {
        color: #ffc87a;
      }
      .spec-body .y-b {
        color: #c29cff;
      }
      .spec-body .y-c {
        color: #5a6b8c;
        font-style: italic;
      }
      .spec-body .y-p {
        color: #7f95c0;
      }
      .spec-body .y-a {
        color: #9adcff;
      }
      .logline.logerr .lb-msg {
        color: var(--red);
      }
      .modal-foot {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 16px;
        border-top: 1px solid var(--line);
        background: var(--panel);
        font-size: 12px;
        color: var(--dim);
      }
      #selInfo {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
        font-family: var(--mono);
        color: var(--muted);
      }

      /* ---------- responsive ---------- */
      @media (max-width: 900px) {
        .hide-sm {
          display: none;
        }
        .updated {
          display: none;
        }
      }
      @media (max-width: 640px) {
        .cards,
        .cards.row2 {
          grid-template-columns: repeat(2, 1fr);
          padding: 12px;
        }
        .card .value {
          font-size: 22px;
        }
        .toolbar,
        .tablewrap {
          padding: 0 12px;
        }
        .modal {
          padding: 0;
        }
        .modal-window {
          width: 100%;
          height: 100%;
          border: 0;
          border-radius: 0;
        }
        .hide-md {
          display: none;
        }
        .lb-time {
          display: none;
        }
        .modal-tools input[type="search"] {
          width: 140px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">CB</div>
      <h1>CrossBoard</h1>
      <span class="updated" id="updated"
        >{{.Generated.Format "2006-01-02 15:04:05"}}</span
      >
      <div class="auto">
        <button id="autoBtn" title="Toggle automatic table refresh">
          Update
        </button>
        <select id="autoInt" title="Refresh interval">
          <option value="10" selected>10s</option>
          <option value="20">20s</option>
          <option value="30">30s</option>
          <option value="60">60s</option>
        </select>
      </div>
    </header>

    {{if .Error}}
    <div class="banner">Some clusters are unavailable: {{.Error}}</div>
    {{end}}

    <section class="cards" id="cards">
      {{range $i,$c := .Cards}}{{if lt $i 10}}
      <div
        class="card {{.Color}}"
        title="{{.Hint}}"
        {{if
        .Scope}}
        data-scope="{{.Scope}}"
        {{end}}
      >
        <div class="label">{{.Label}}</div>
        <div class="value">{{.Value}}</div>
      </div>
      {{end}}{{end}}
    </section>
    <section class="cards row2" id="cards2">
      {{range $i,$c := .Cards}}{{if ge $i 10}}
      <div
        class="card {{.Color}}"
        title="{{.Hint}}"
        {{if
        .Scope}}
        data-scope="{{.Scope}}"
        {{end}}
      >
        <div class="label">{{.Label}}</div>
        <div class="value">{{.Value}}</div>
      </div>
      {{end}}{{end}}
    </section>

    <section class="toolbar">
      <div class="search-wrap">
        <input
          id="fQ"
          type="search"
          placeholder="Filter by pod or container name"
          autocomplete="off"
        />
        <span class="ico">&#8981;</span>
      </div>
      <select id="fCtx">
        <option value="">Cluster: all</option>
        {{range .Contexts}}
        <option value="{{.}}">{{.}}</option>
        {{end}}
      </select>
      <select id="fNs">
        <option value="">Namespace: all</option>
        {{range .Namespaces}}
        <option value="{{.}}">{{.}}</option>
        {{end}}
      </select>
      <select id="fNode">
        <option value="">Node: all</option>
        {{range .Nodes}}
        <option value="{{.}}">{{.}}</option>
        {{end}}
      </select>
      <select id="fKind">
        <option value="">Workload: all</option>
      </select>
      <select id="fPhase">
        <option value="">Phase: all</option>
        {{range .Phases}}
        <option value="{{.}}">{{.}}</option>
        {{end}}
      </select>
      <select id="fState">
        <option value="">State: all</option>
        {{range .States}}
        <option value="{{.}}">{{.}}</option>
        {{end}}
      </select>
      <div class="actions">
        <button id="btnClear" title="Clear all selections">Clear</button>
        <button class="primary" id="btnOpen">Show logs</button>
      </div>
    </section>

    <section class="tablewrap">
      <div class="panel">
        <div class="table-scroll">
          <table id="podTable">
            <thead>
              <tr>
                <th class="col-chk">
                  <input
                    type="checkbox"
                    id="selectAll"
                    title="Select all visible"
                  />
                </th>
                <th data-key="ctx">Cluster</th>
                <th data-key="ns">Namespace</th>
                <th data-key="pod">Pod</th>
                <th data-key="cont">Container</th>
                <th data-key="age">Age</th>
                <th data-key="phase">Phase</th>
                <th data-key="state">State</th>
                <th data-key="ready">Ready</th>
                <th data-key="rests">Restarts</th>
                <th data-key="cpu" class="hide-sm hide-md">CPU</th>
                <th data-key="mem" class="hide-sm hide-md">Mem</th>
              </tr>
            </thead>
            <tbody id="tbody">
              {{range .Pods}}
              <tr
                data-ix="{{.ID}}"
                data-ctx="{{.Context}}"
                data-ns="{{.Namespace}}"
                data-pod="{{.Name}}"
                data-cont="{{.Container}}"
                data-node="{{.Node}}"
                data-phase="{{.Phase}}"
                data-state="{{.State}}"
                data-ready="{{.Ready}}"
                data-rests="{{.RestartCount}}"
                data-image="{{.Image}}"
                data-cpu="{{.Cpu}}"
                data-mem="{{.Mem}}"
                data-ts="{{.Created}}"
                data-owner="{{.Owner}}"
                data-ownerkind="{{.OwnerKind}}"
                data-workload="{{.Workload}}"
                data-cpuuse="{{.CpuUse}}"
                data-memuse="{{.MemUse}}"
              >
                <td class="chk">
                  <input type="checkbox" class="row-check" value="{{.ID}}" />
                </td>
                <td class="ctx">{{.Context}}</td>
                <td class="ns">{{.Namespace}}</td>
                <td class="pod">{{.Name}}</td>
                <td class="cont">{{.Container}}</td>
                <td class="created" title="created {{.Created}}">{{.Age}}</td>
                <td><span class="badge {{.PhaseCss}}">{{.Phase}}</span></td>
                <td><span class="badge {{.StateCss}}">{{.State}}</span></td>
                <td>
                  {{if .Ready}}<span class="badge yes">Yes</span>{{else}}<span
                    class="badge no"
                    >No</span
                  >{{end}}
                </td>
                <td>
                  {{if gt .RestartCount 0}}<span class="badge warn"
                    >{{.RestartCount}}</span
                  >{{else}}<span class="badge muted">0</span>{{end}}
                </td>
                <td
                  class="cpu hide-sm hide-md"
                  title="CPU usage/limit, % of limit"
                >
                  {{.Cpu}}
                </td>
                <td
                  class="mem hide-sm hide-md"
                  title="Memory usage/limit, % of limit"
                >
                  {{.Mem}}
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="12" class="empty">
                  No pods found. Check your kubeconfig and cluster availability.
                </td>
              </tr>
              {{end}}
            </tbody>
            <tfoot>
              <tr>
                <td class="sel" id="selFoot">0</td>
                <td colspan="11" id="selFootLabel">containers selected</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <div id="modal" class="modal hidden" role="dialog" aria-modal="true">
      <div class="modal-window">
        <header class="modal-head">
          <div class="modal-tools">
            <div class="mt-row" id="toolsFilters">
              <input
                id="logFilter"
                type="search"
                placeholder="Filter log content..."
                autocomplete="off"
              />
              <div
                class="seg"
                id="modeSeg"
                title="Match mode (mutually exclusive): Plain = exact substring, AND = all words, OR = any word, Regex"
              >
                <label class="seg-btn"
                  ><input
                    type="radio"
                    name="logMode"
                    value="text"
                    checked
                  /><span>Plain</span></label
                >
                <label class="seg-btn"
                  ><input type="radio" name="logMode" value="and" /><span
                    >AND</span
                  ></label
                >
                <label class="seg-btn"
                  ><input type="radio" name="logMode" value="or" /><span
                    >OR</span
                  ></label
                >
                <label class="seg-btn"
                  ><input type="radio" name="logMode" value="regex" /><span
                    >Regex</span
                  ></label
                >
                <span class="seg-thumb"></span>
              </div>
              <label class="sw" title="Ignore case (insensitive)">
                <input type="checkbox" id="insensChk" checked /><span
                  class="trk"
                ></span
                >Ignore-case
              </label>
              <label
                class="sw"
                title="Show 1 line before/after each match (grep -A 1 -B 1)"
              >
                <input type="checkbox" id="ctxChk" /><span class="trk"></span
                >Context
              </label>
              <label
                class="sw"
                title="Wrap long lines (off = horizontal scroll)"
              >
                <input type="checkbox" id="wrapChk" checked /><span
                  class="trk"
                ></span
                >Word-wrap
              </label>
              <label class="sw" title="Show built-in kubectl timestamps">
                <input type="checkbox" id="tsChk" checked /><span
                  class="trk"
                ></span
                >Timestamp
              </label>
            </div>
            <div class="mt-row" id="toolsModes">
              <button id="followChk" class="tgl on" title="Follow new lines">
                Follow
              </button>
              <button
                id="btnPause"
                class="tgl"
                title="Pause / resume the stream"
              >
                Pause
              </button>
              <button
                id="autoScroll"
                class="tgl on"
                title="Auto scroll to the newest line"
              >
                Scroll
              </button>
              <button id="btnClear">Clear</button>
              <button id="btnDownload">Download</button>
              <select
                id="sinceSel"
                class="sel"
                title="Time window: how far back to load log history"
              >
                <option value="">Age: all</option>
                <option value="1h">1h</option>
                <option value="3h">3h</option>
                <option value="6h">6h</option>
                <option value="12h">12h</option>
                <option value="24h">24h</option>
                <option value="48h">48h</option>
                <option value="72h">72h</option>
                <option value="168h">168h</option>
              </select>
              <select
                id="linesSel"
                class="sel"
                title="Number of recent lines to load (All = live only, no history)"
              >
                <option value="0" selected>History: no</option>
                <option value="100">100</option>
                <option value="500">500</option>
                <option value="1000">1000</option>
                <option value="2000">2000</option>
                <option value="3000">3000</option>
                <option value="5000">5000</option>
                <option value="10000">10000</option>
              </select>
              <span class="conn wait" id="connState">-</span>
              <span class="count" id="lineCount">0</span>
            </div>
          </div>
          <button id="btnClose" class="modal-close" title="Close">
            &#10005;
          </button>
        </header>
        <div id="logBody" class="log-body"></div>
        <footer class="modal-foot">
          <span id="selInfo"></span>
          <span>click a line to copy its text</span>
        </footer>
      </div>
    </div>

    <div id="specModal" class="modal hidden" role="dialog" aria-modal="true">
      <div class="modal-window">
        <header class="modal-head">
          <h2>Resources <span id="specTitle"></span></h2>
          <button id="btnSpecClose" class="modal-close" title="Close">
            &#10005;
          </button>
        </header>
        <div class="spec-meta" id="specMeta"></div>
        <div class="spec-wrap">
          <nav class="spec-list">
            <div class="spec-tools">
              <input
                id="specFilter"
                type="search"
                placeholder="Filter by kind or name"
                autocomplete="off"
              />
              <input
                id="specSearch"
                type="search"
                placeholder="Search by manifest"
                autocomplete="off"
              />
              <span class="search-stat" id="searchStat"></span>
              <div class="spec-chips" id="specChips"></div>
            </div>
            <div class="spec-items" id="specItems"></div>
          </nav>
          <pre id="specBody" class="spec-body">Loading...</pre>
        </div>
      </div>
    </div>

    <div id="eventsModal" class="modal hidden" role="dialog" aria-modal="true">
      <div class="modal-window">
        <header class="modal-head">
          <h2>Resources <span>Events</span></h2>
          <button id="btnEvClose" class="modal-close" title="Close">
            &#10005;
          </button>
        </header>
        <div class="spec-tools">
          <div class="mt-row">
            <input
              id="evFilter"
              type="search"
              placeholder="Filter by event messages"
              autocomplete="off"
            />
            <select id="evCtx" title="Filter by cluster">
              <option value="">Cluster: all</option>
            </select>
            <div
              class="seg"
              id="evTypeSeg"
              title="Filter by event type (mutually exclusive): All, Normal, Warning"
            >
              <label class="seg-btn"
                ><input type="radio" name="evType" value="" checked /><span
                  >All</span
                ></label
              >
              <label class="seg-btn"
                ><input type="radio" name="evType" value="Normal" /><span
                  >Normal</span
                ></label
              >
              <label class="seg-btn"
                ><input type="radio" name="evType" value="Warning" /><span
                  >Warning</span
                ></label
              >
              <span class="seg-thumb"></span>
            </div>
            <label class="sw" title="Wrap long messages">
              <input type="checkbox" id="evWrap" checked /><span
                class="trk"
              ></span
              >Word-wrap
            </label>
            <span class="count" id="evStat"></span>
          </div>
          <div class="spec-chips" id="evKinds"></div>
        </div>
        <div class="tablewrap">
          <div class="panel">
            <div class="table-scroll" id="evScroll">
              <table id="eventsTable">
                <thead>
                  <tr>
                    <th class="age">Age</th>
                    <th class="ctx">Cluster</th>
                    <th class="ns">Namespace</th>
                    <th class="name">Object</th>
                    <th class="type">Type</th>
                    <th class="reason">Reason</th>
                    <th class="msg">Message</th>
                  </tr>
                </thead>
                <tbody id="eventsBody">
                  <tr>
                    <td colspan="7" class="empty">Loading...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      (function () {
      "use strict";
      var $ = function (s) { return document.querySelector(s); };
      var INIT_STATS = {avail: {{.Stats.AvailCtx}}, total: {{.Stats.Contexts}}, cpuTotal: {{.Stats.CpuTotalMilli}}, memTotal: {{.Stats.MemTotalBytes}}};
      var INIT_NS = {{.NSJSON}};
      var modal = $("#modal");
      var logBody = $("#logBody");
      var tbody = $("#tbody");
      var fQ = $("#fQ"), fKind = $("#fKind"), fCtx = $("#fCtx"), fNs = $("#fNs"), fNode = $("#fNode"), fPhase = $("#fPhase"), fState = $("#fState");
      var selectAll = $("#selectAll"), btnOpen = $("#btnOpen"), btnClear = $("#btnClear");
      var selFoot = $("#selFoot"), selFootLabel = $("#selFootLabel");
      var connState = $("#connState"), lineCountEl = $("#lineCount"), selInfo = $("#selInfo");
      var logFilter = $("#logFilter"), insens = $("#insensChk"), ctxChk = $("#ctxChk"), autoScroll = $("#autoScroll");
      var sinceSel = $("#sinceSel"), followChk = $("#followChk"), linesSel = $("#linesSel");
      var wrapChk = $("#wrapChk"), tsChk = $("#tsChk");
      var btnPause = $("#btnPause");
      var specModal = $("#specModal"), specBody = $("#specBody"), specTitle = $("#specTitle");
      var specItems = $("#specItems"), specChips = $("#specChips"), specMeta = $("#specMeta");
      var specFilter = $("#specFilter"), specSearch = $("#specSearch");
      var autoBtn = $("#autoBtn"), autoInt = $("#autoInt");

      var rows = [];
      var ES = null;
      var paused = false;
      var totalLines = 0;
      var shownLines = 0;
      var maxCtxW = 9, maxPodW = 16;
      var sortKey = "ctx";
      var sortDir = 1;
      var kindDefaulted = false;

      function norm(s) { return String(s == null ? "" : s).trim().toLowerCase(); }

      function rowTokens(tr) {
        return norm([tr.dataset.pod, tr.dataset.cont].join(" "));
      }

      function cacheRows() { rows = Array.prototype.slice.call(tbody.querySelectorAll("tr")); }

      function populateKindFilter() {
        var kinds = {};
        rows.forEach(function (tr) {
          if (!tr.dataset || !tr.dataset.workload) return;
          kinds[tr.dataset.workload] = 1;
        });
        var hasBare = rows.some(function (tr) { return tr.dataset && !tr.dataset.workload; });
        var prev = fKind.value;
        fKind.innerHTML = "";
        var o = document.createElement("option");
        o.value = ""; o.textContent = "Workload: all";
        fKind.appendChild(o);
        Object.keys(kinds).sort().forEach(function (k) {
          var opt = document.createElement("option");
          opt.value = k; opt.textContent = k + "s";
          fKind.appendChild(opt);
        });
        if (hasBare) {
          var ob = document.createElement("option");
          ob.value = "_pod"; ob.textContent = "Pod (no owner)";
          fKind.appendChild(ob);
        }
        if (prev === "" && !kindDefaulted && kinds["Deployment"]) {
          fKind.value = "Deployment";
        } else {
          var ok = false;
          Array.prototype.forEach.call(fKind.options, function (op) { if (op.value === prev) ok = true; });
          fKind.value = ok ? prev : "";
        }
        kindDefaulted = true;
      }

      function parseCpuMilli(v) {
        v = String(v == null ? "" : v).trim().toLowerCase();
        if (!v) return 0;
        if (v.slice(-1) === "m") return parseFloat(v.slice(0, -1)) || 0;
        return (parseFloat(v) || 0) * 1000;
      }

      function parseMemKi(v) {
        v = String(v == null ? "" : v).trim().toLowerCase();
        if (!v) return 0;
        var m = /^([\d.]+)\s*([kKmMgGtT]?i?)?$/.exec(v);
        if (!m) return 0;
        var n = parseFloat(m[1]);
        var mult = 1;
        switch (m[2]) {
          case "k": case "ki": mult = 1 << 10; break;
          case "m": case "mi": mult = 1 << 20; break;
          case "g": case "gi": mult = 1 << 30; break;
          case "t": case "ti": mult = 1 << 40; break;
        }
        return n * mult;
      }

      // Пересчёт карточек по текущим фильтрам. «Подовые» карточки
      // (Clusters/Ns/Pods/Containers/CPU/MEM) считаются по видимым строкам таблицы,
      // а Jobs/Charts/Service/Configs/Events/PVC — по статистике per-cluster+namespace
      // (INIT_NS или свежий /api/pods), ограниченной выбранным узлом/кластером/namespace.
      // Знаменатели allocatable берут из сводки (INIT_STATS или свежий /api/pods).
      function recalcCards() {
        var src = (window.__crossboardData && window.__crossboardData.stats) || INIT_STATS;
        var ctxSet = {}, nsSet = {}, podSet = {}, podRunning = 0, cont = 0, contRunning = 0;
        var cpuUse = 0, memUse = 0;
        rows.forEach(function (tr) {
          if (tr.style.display === "none") return;
          if (!tr.dataset || !tr.dataset.ctx) return;
          ctxSet[tr.dataset.ctx] = 1;
          nsSet[tr.dataset.ns] = 1;
          var pk = tr.dataset.ctx + "|" + tr.dataset.ns + "|" + tr.dataset.pod;
          if (tr.dataset.phase === "Running") podRunning++;
          if (tr.dataset.phase === "Running") contRunning++;
          cont++;
          podSet[pk] = 1;
          if (tr.dataset.cpuuse) cpuUse += parseCpuMilli(tr.dataset.cpuuse);
          if (tr.dataset.memuse) memUse += parseMemKi(tr.dataset.memuse);
        });
        var pods = Object.keys(podSet).length;
        var ready = optsCnt(ctxSet);
        setCardValue("Clusters", ready + "/" + (src.total || 0));
        setCardValue("Namespaces", Object.keys(nsSet).length);
        setCardValue("Pods", podRunning + "/" + pods);
        setCardValue("Containers", contRunning + "/" + cont);
        // Если в видимых строках нет данных об использовании (метрики недоступны
        // или кластер без metrics-server), не затираем серверные значения карточек.
        if (cpuUse > 0 || memUse > 0) {
          setCardValue("CPU", fmtCore(cpuUse) + "/" + fmtCore(src.cpuTotal || 0));
          setCardValue("Memory", fmtGiB(memUse) + "/" + fmtGiB(src.memTotal || 0) + " GiB");
        }
        // Карточки ресурсов (Jobs/Charts/Service/Configs/Events/PVC) считаются из
        // статистики per-cluster+namespace (INIT_NS или свежий /api/pods). Они всегда
        // привязаны к выбранному кластеру: при фильтре по кластеру/ноде/namespace
        // суммируются только подходящие пары (ctx, ns), при «все кластера» —
        // все записи NS (это и есть серверные итоги).
        var nsData = (window.__crossboardData && window.__crossboardData.ns) || INIT_NS;
        var keys = {};
        if (fNode.value) {
          // Узел: namespace берём из видимых строк отфильтрованной таблицы.
          rows.forEach(function (tr) {
            if (tr.style.display === "none") return;
            if (tr.dataset && tr.dataset.ctx) keys[tr.dataset.ctx + "|" + tr.dataset.ns] = 1;
          });
        } else if (fNs.value) {
          keys = nsKeysForNamespace(nsData, fNs.value, fCtx.value);
        } else if (fCtx.value) {
          // Кластер: все namespace этого кластера из NS (включая namespace без подов).
          keys = nsKeysForCtx(nsData, fCtx.value);
        } else {
          // Все кластеры: полная сводка.
          keys = allNSCount(nsData);
        }
        var jobs = 0, jobsDone = 0, net = 0, cfg = 0, ev = 0, charts = 0;
        var pvcBound = 0, pvcTotal = 0, pvcTotalBytes = 0, pvcOk = 0;
        for (var k in keys) {
          var s = nsData[k];
          if (!s) continue;
          jobs += s.Jobs; jobsDone += s.JobsDone;
          net += s.Services; cfg += s.Configs; ev += s.EventsWarning; charts += s.Charts;
          pvcBound += s.PVCBound; pvcTotal += s.PVCTotal;
          pvcTotalBytes += s.PVCTotalBytes;
          if (s.PVCOk) pvcOk = 1;
        }
        // Nodes кластер-scoped и лежит на ключе "ctx|cluster", который входит в keys при
        // выборе кластера и «все кластера», но отсутствует в паре (ctx,ns) при фильтре по
        // ноде/namespace. Поэтому Nodes всегда пересчитываем за кластеры текущего выбора,
        // чтобы карточка не «залипала» на старом значении при возврате к «все кластера».
        var clCtx = {};
        if (fCtx.value) {
          clCtx[fCtx.value] = 1;
        } else {
          for (var k in keys) {
            var sep = k.indexOf("|");
            if (sep > 0) clCtx[k.slice(0, sep)] = 1;
          }
        }
        var nodeReady = 0, nodeTotal = 0, nodeOk = 0, pvTotalBytes = 0;
        for (var c in clCtx) {
          var cn = nsData[c + "|cluster"];
          if (!cn) continue;
          nodeReady += cn.NodeReady; nodeTotal += cn.NodeTotal;
          if (cn.NodeOk) nodeOk = 1;
          if (cn.PVTotalBytes) pvTotalBytes += cn.PVTotalBytes;
        }
        setCardValue("Jobs", fracTxt(jobsDone, jobs));
        setCardValue("Service", String(net));
        setCardValue("Configs", String(cfg));
        setCardValue("Charts", String(charts));
        setCardValue("Events", String(ev));
        setCardValue("PVC/PV size", fmtGiB(pvcTotalBytes) + "/" + fmtGiB(pvTotalBytes) + " GiB");
        setCardValue("PVC/PV Count", pvcOk > 0 ? fracTxt(pvcBound, pvcTotal) : String(pvcBound));
        setCardValue("Nodes", nodeOk > 0 ? fracTxt(nodeReady, nodeTotal) : String(nodeReady));
        var scoped = !!(fNode.value || fCtx.value || fNs.value);
        var tl = scoped ? ", for selected cluster/node/namespace" : " across clusters";
        setCardHint("Jobs", "succeeded jobs / total (jobs + cronjobs)" + tl);
        setCardHint("Service", "services across clusters" + tl);
        setCardHint("Configs", "configmaps + secrets (list includes RBAC)" + tl);
        setCardHint("Charts", "helm releases" + tl);
        setCardHint("Events", "events with type=Warning" + tl);
        setCardHint("PVC/PV size", "sum of PVC requests / total PV capacity" + tl);
        setCardHint("PVC/PV Count", "bound PVC / total PVC (PV, PersistentVolumeClaim, StorageClass)" + tl);
      }

      function nsKeysForCtx(nsData, ctx) {
        var out = {};
        for (var k in nsData) {
          if (k.indexOf(ctx + "|") === 0) out[k] = 1;
        }
        return out;
      }

      function nsKeysForNamespace(nsData, ns, ctx) {
        var out = {};
        for (var k in nsData) {
          var idx = k.indexOf("|");
          if (idx === -1) continue;
          var c = k.slice(0, idx), n = k.slice(idx + 1);
          if (n !== ns) continue;
          if (ctx && c !== ctx) continue;
          out[k] = 1;
        }
        return out;
      }

      function allNSCount(nsData) {
        var out = {};
        for (var k in nsData) out[k] = 1;
        return out;
      }

      function optsCnt(obj) {
        var n = 0;
        for (var k in obj) if (Object.prototype.hasOwnProperty.call(obj, k)) n++;
        return n;
      }

      function setCardValue(label, value) {
        var hosts = [document.getElementById("cards"), document.getElementById("cards2")];
        for (var i = 0; i < hosts.length; i++) {
          var h = hosts[i];
          if (!h) continue;
          var cards = h.querySelectorAll(".card");
          for (var j = 0; j < cards.length; j++) {
            var l = cards[j].querySelector(".label");
            if (l && l.textContent === label) {
              cards[j].querySelector(".value").textContent = value;
              return cards[j];
            }
          }
        }
        return null;
      }

      function setCardHint(label, hint) {
        var hosts = [document.getElementById("cards"), document.getElementById("cards2")];
        for (var i = 0; i < hosts.length; i++) {
          var h = hosts[i];
          if (!h) continue;
          var cards = h.querySelectorAll(".card");
          for (var j = 0; j < cards.length; j++) {
            var l = cards[j].querySelector(".label");
            if (l && l.textContent === label) {
              cards[j].title = hint;
              return;
            }
          }
        }
      }

      function fracTxt(a, b) {
        if ((b <= 0) && (a <= 0)) return "0/0";
        return a + "/" + b;
      }

      function fmtCore(milli) { return (milli / 1000).toFixed(2); }
      function fmtGiB(bytes) { return (bytes / (1 << 30)).toFixed(2); }

      function applyFilters() {
        var q = norm(fQ.value);
        var c = fCtx.value, n = fNs.value, nd = fNode.value, p = fPhase.value, w = fKind.value, s = fState.value;
        var vis = 0;
        rows.forEach(function (tr) {
          var ok = (!q || rowTokens(tr).indexOf(q) !== -1);
          if (ok && c && tr.dataset.ctx !== c) ok = false;
          if (ok && n && tr.dataset.ns !== n) ok = false;
          if (ok && nd && tr.dataset.node !== nd) ok = false;
          if (ok && p && tr.dataset.phase !== p) ok = false;
          if (ok && s && tr.dataset.state !== s) ok = false;
          if (ok && w) {
            if (w === "_pod") { if (tr.dataset.workload) ok = false; }
            else if (tr.dataset.workload !== w) ok = false;
          }
          tr.style.display = ok ? "" : "none";
          if (ok) vis++;
        });
        var e2 = document.getElementById("emptyRow");
        if (vis === 0 && rows.length > 0) {
          if (!e2) {
            e2 = document.createElement("tr");
            e2.id = "emptyRow";
            var td = document.createElement("td");
            td.colSpan = 12;
            td.className = "empty";
            td.textContent = "Nothing found for the given filters.";
            e2.appendChild(td);
            tbody.appendChild(e2);
          } else { e2.style.display = ""; }
        } else if (e2) { e2.style.display = "none"; }
        recalcCards();
      }

      function updateSel() {
        var n = tbody.querySelectorAll(".row-check:checked").length;
        selFoot.textContent = n;
        selFootLabel.textContent = n === 1 ? "container selected" : "containers selected";
        btnOpen.disabled = n === 0;
        var boxes = tbody.querySelectorAll(".row-check");
        for (var i = 0; i < boxes.length; i++) {
          var tr = boxes[i].closest ? boxes[i].closest("tr") : null;
          if (tr) tr.classList.toggle("row-on", boxes[i].checked);
        }
      }

      function checkAllVisible() {
        rows.forEach(function (tr) {
          if (tr.style.display !== "none") {
            var cb = tr.querySelector(".row-check");
            if (cb) cb.checked = selectAll.checked;
          }
        });
        updateSel();
      }

      function nodesForCtx() {
        var c = fCtx.value, n = fNs.value;
        var set = {}, out = [];
        rows.forEach(function (tr) {
          if (!tr.dataset || !tr.dataset.node) return;
          if (c && tr.dataset.ctx !== c) return;
          if (n && tr.dataset.ns !== n) return;
          if (!set[tr.dataset.node]) { set[tr.dataset.node] = 1; out.push(tr.dataset.node); }
        });
        return out.sort();
      }

      function scopeNodeList() {
        fillSelect(fNode, nodesForCtx(), "Node: all");
      }

      fQ.addEventListener("input", applyFilters);
      fKind.addEventListener("change", applyFilters);
      fCtx.addEventListener("change", function () { scopeNodeList(); applyFilters(); });
      fNs.addEventListener("change", function () { scopeNodeList(); applyFilters(); });
      fNode.addEventListener("change", applyFilters);
      fPhase.addEventListener("change", applyFilters);
      fState.addEventListener("change", applyFilters);
      selectAll.addEventListener("change", checkAllVisible);
      var selAnchor = -1;
      tbody.addEventListener("click", function (e) {
        var cb = e.target;
        if (!cb.classList || !cb.classList.contains("row-check")) return;
        var boxes = tbody.querySelectorAll(".row-check");
        var idx = -1;
        for (var i = 0; i < boxes.length; i++) { if (boxes[i] === cb) { idx = i; break; } }
        if (e.shiftKey && selAnchor >= 0 && idx >= 0) {
          var state = cb.checked;
          var lo = Math.min(selAnchor, idx), hi = Math.max(selAnchor, idx);
          for (var j = lo; j <= hi; j++) boxes[j].checked = state;
        }
        selAnchor = idx;
        updateSel();
      });

      /* ---------- sorting ---------- */
      function cellValue(tr, key) {
        switch (key) {
          case "node": return String(tr.dataset.node || "");
          case "ctx": return String(tr.dataset.ctx || "");
          case "ns": return String(tr.dataset.ns || "");
          case "pod": return String(tr.dataset.pod || "");
          case "cont": return String(tr.dataset.cont || "");
          case "phase": return String(tr.dataset.phase || "");
          case "state": return String(tr.dataset.state || "");
          case "cpu": return String(tr.dataset.cpu || "");
          case "mem": return String(tr.dataset.mem || "");
          case "age": return String(tr.dataset.ts || "");
          case "ready": return tr.dataset.ready === "true" ? 1 : 0;
          case "rests": return parseInt(tr.dataset.rests || "0", 10) || 0;
        }
        return "";
      }

      function sortRows() {
        var key = sortKey, dir = sortDir;
        var arr = rows.slice();
        arr.sort(function (a, b) {
          var va = cellValue(a, key), vb = cellValue(b, key);
          var cmp;
          if (typeof va === "number" && typeof vb === "number") { cmp = va - vb; }
          else { cmp = String(va).localeCompare(String(vb), undefined, { numeric: true, sensitivity: "base" }); }
          return cmp * dir;
        });
        arr.forEach(function (tr) { tbody.appendChild(tr); });
        rows = arr;
        applyFilters();
      }

      var headers = Array.prototype.slice.call(document.querySelectorAll("thead th[data-key]"));
      headers.forEach(function (th) {
        th.addEventListener("click", function () {
          var k = th.dataset.key;
          if (sortKey === k) { sortDir = -sortDir; } else { sortKey = k; sortDir = 1; }
          headers.forEach(function (h) { h.classList.remove("sorted", "asc", "desc"); });
          th.classList.add("sorted", sortDir === 1 ? "asc" : "desc");
          sortRows();
        });
      });

      /* ---------- auto refresh ---------- */
      var autoTimer = null;
      var autoOn = false;

      function doRefresh() {
        fetch("/api/pods").then(function (r) { return r.json(); })
          .then(renderAll)
          .catch(function (err) { console.error(err); });
      }

      function setAuto(on) {
        autoOn = on;
        autoBtn.classList.toggle("on", on);
        if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
        if (on) {
          doRefresh();
          autoTimer = setInterval(doRefresh, parseInt(autoInt.value, 10) * 1000);
        }
      }

      autoBtn.addEventListener("click", function () { setAuto(!autoOn); });
      autoInt.addEventListener("change", function () { if (autoOn) setAuto(true); });

      function fmtTime(t) {
        if (!t) return "";
        var d = new Date(t);
        var p = function (x) { return String(x).padStart(2, "0"); };
        return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()) + " " + p(d.getHours()) + ":" + p(d.getMinutes()) + ":" + p(d.getSeconds());
      }

      function renderCards(host, cards) {
        host.innerHTML = "";
        cards.forEach(function (cd) {
          var div = document.createElement("div");
          div.className = "card " + cd.color;
          div.title = cd.hint;
          if (cd.scope) div.dataset.scope = cd.scope;
          div.innerHTML = "<div class='label'></div><div class='value'></div>";
          div.querySelector(".label").textContent = cd.label;
          div.querySelector(".value").textContent = cd.value;
          host.appendChild(div);
        });
      }

      function fillSelect(sel, items, label) {
        var prev = sel.value;
        var ph = document.createElement("option");
        ph.value = ""; ph.textContent = label;
        sel.innerHTML = "";
        sel.appendChild(ph);
        items.forEach(function (it) {
          var o = document.createElement("option");
          o.value = it; o.textContent = it;
          sel.appendChild(o);
        });
        sel.value = prev;
      }

      function renderSelects(ctxs, nss, nodes, phases, states) {
        fillSelect(fCtx, ctxs, "Cluster: all");
        fillSelect(fNs, nss, "Namespace: all");
        fillSelect(fNode, nodes, "Node: all");
        fillSelect(fPhase, phases, "Phase: all");
        fillSelect(fState, states, "State: all");
      }

      function phaseCss(ph) {
        if (ph === "Running" || ph === "Succeeded") return "ok";
        if (ph === "Pending") return "warn";
        if (ph === "Failed" || ph === "Unknown") return "err";
        return "unk";
      }
      function stateCss(st) {
        if (st === "Running" || st === "Succeeded") return "ok";
        if (st.indexOf("Waiting") === 0 || st === "Pending") return "warn";
        if (st.indexOf("Terminated") === 0) return "err";
        return "unk";
      }

      function renderTable(pods) {
        tbody.innerHTML = "";
        if (!pods || pods.length === 0) {
          var tr0 = document.createElement("tr");
          var td0 = document.createElement("td");
          td0.colSpan = 12; td0.className = "empty";
          td0.textContent = "No pods found. Check your kubeconfig and cluster availability.";
          tr0.appendChild(td0);
          tbody.appendChild(tr0);
          cacheRows();
          updateSel();
          return;
        }
        var mk = function (tag, cls, txt) {
          var el = document.createElement(tag);
          if (cls) el.className = cls;
          if (txt != null) el.textContent = txt;
          return el;
        };
        var td = function (cls, txt) { return mk("td", cls, txt); };
        var badge = function (cls, txt) {
          var s = document.createElement("span");
          s.className = "badge " + cls; s.textContent = txt;
          return s;
        };

        pods.forEach(function (p) {
          var tr = document.createElement("tr");
          tr.dataset.ix = [p.context, p.namespace, p.name, p.container].join("|");
          tr.dataset.ctx = p.context; tr.dataset.ns = p.namespace; tr.dataset.pod = p.name;
          tr.dataset.cont = p.container; tr.dataset.node = p.node; tr.dataset.phase = p.phase;
          tr.dataset.state = p.state; tr.dataset.ready = p.ready; tr.dataset.rests = p.restarts;
          tr.dataset.image = p.image; tr.dataset.cpu = p.cpu || ""; tr.dataset.mem = p.mem || "";
          tr.dataset.ts = p.created || "";
          tr.dataset.owner = p.owner || ""; tr.dataset.ownerkind = p.ownerkind || "";
          tr.dataset.workload = p.workload || "";
          tr.dataset.labels = p.labels || "";
          tr.dataset.cpuuse = p.cpuuse || ""; tr.dataset.memuse = p.memuse || "";

          var t1 = td("chk", null);
          var cb = document.createElement("input");
          cb.type = "checkbox"; cb.className = "row-check"; cb.value = tr.dataset.ix;
          t1.appendChild(cb);

          tr.appendChild(t1);
          tr.appendChild(td("ctx", p.context));
          tr.appendChild(td("ns", p.namespace));
          tr.appendChild(td("pod", p.name));
          tr.appendChild(td("cont", p.container));

          var t0 = td("created", p.age || "");
          t0.title = "created " + (p.created || ""); tr.appendChild(t0);

          var t2 = td(null, null); t2.appendChild(badge(phaseCss(p.phase), p.phase)); tr.appendChild(t2);
          var t3 = td(null, null); t3.appendChild(badge(stateCss(p.state), p.state)); tr.appendChild(t3);
          var t4 = td(null, null); t4.appendChild(badge(p.ready ? "yes" : "no", p.ready ? "Yes" : "No")); tr.appendChild(t4);
          var t5 = td(null, null);
          t5.appendChild(badge(p.restarts > 0 ? "warn" : "muted", p.restarts || 0));
          tr.appendChild(t5);

          var t6 = td("cpu hide-sm hide-md", p.cpu || "");
          t6.title = "% of limit (CPU usage / limit)"; tr.appendChild(t6);
          var t7 = td("mem hide-sm hide-md", p.mem || "");
          t7.title = "% of limit (MEM usage / limit)"; tr.appendChild(t7);

          tbody.appendChild(tr);
        });
        cacheRows();
        populateKindFilter();
        updateSel();
      }

      function renderAll(d) {
        var checked = {};
        tbody.querySelectorAll(".row-check:checked").forEach(function (cb) { checked[cb.value] = 1; });
        window.__crossboardData = d;
        var cards = d.cards || [];
        renderCards($("#cards"), cards.slice(0, 10));
        renderCards($("#cards2"), cards.slice(10));
        renderSelects(d.contexts || [], d.namespaces || [], d.nodes || [], d.phases || [], d.states || []);
        renderTable(d.pods || []);
        scopeNodeList();
        tbody.querySelectorAll(".row-check").forEach(function (cb) {
          if (checked[cb.value]) cb.checked = true;
        });
        updateSel();
        var up = $("#updated");
        if (up) up.textContent = fmtTime(d.generated);
        var bn = $(".banner");
        if (d.error) {
          if (!bn) {
            bn = document.createElement("div");
            bn.className = "banner";
            var header = document.querySelector("header");
            header.parentNode.insertBefore(bn, header.nextSibling);
          }
          bn.textContent = "Some clusters are unavailable: " + d.error;
        } else if (bn && bn.parentNode) { bn.parentNode.removeChild(bn); }
        if (rows.length > 0) sortRows(); else applyFilters();
      }

      cacheRows();
      populateKindFilter();
      applyFilters();
      updateSel();
      setAuto(true);

      /* ================= live log modal ================= */

      function selectedIDs() {
        var out = [];
        tbody.querySelectorAll(".row-check:checked").forEach(function (cb) { out.push(cb.value); });
        return out;
      }

      function setConn(html, cls) {
        connState.textContent = html;
        connState.className = "conn " + (cls || "wait");
      }

      function clearLog() {
        streamRetries = 0;
        lastKey = null;
        logBody.innerHTML = "";
        totalLines = 0; shownLines = 0;
        maxCtxW = 9; maxPodW = 16;
        logBody.style.removeProperty("--ctxw");
        logBody.style.removeProperty("--podw");
        setConn("-", "wait");
        lineCountEl.textContent = "0";
        logFilter.value = "";
      }

      function updateSelInfo() {
        var ids = selectedIDs();
        var names = ids.map(function (id) {
          var parts = id.split("|");
          return parts[0] + "/" + parts[2] + "/" + (parts[3] || "-");
        }).join(";  ");
        selInfo.textContent = "Selected containers: " + ids.length + (ids.length ? " — " + names : "");
      }

      function openModal() {
        var ids = selectedIDs();
        if (ids.length === 0) return;
        clearLog();
        modal.classList.remove("hidden");
        paused = false;
        btnPause.textContent = "Pause";
        btnPause.classList.remove("on");
        startStream();
      }

      btnOpen.addEventListener("click", openModal);

      btnClear.addEventListener("click", function () {
        tbody.querySelectorAll(".row-check").forEach(function (cb) { cb.checked = false; });
        selectAll.checked = false;
        selAnchor = -1;
        updateSel();
      });

      function closeStream() {
        if (ES) { ES.close(); ES = null; }
        if (restartTimer) { clearTimeout(restartTimer); restartTimer = null; }
      }

      var streamRetries = 0;
      var lastKey = null;
      var settling = false;
      var settleTimer = null;
      var restartTimer = null;
      var MAX_LOG_LINES = 5000;
      function followOn() { return followChk.classList.contains("on"); }
      function autoScrollOn() { return autoScroll.classList.contains("on"); }
      function settleStart() {
        settling = true;
        if (settleTimer) clearTimeout(settleTimer);
        settleTimer = setTimeout(function () { settling = false; }, 1200);
      }

      function startStream() {
        // Модалка закрыта (или scheduled-рестарт сработал после закрытия) —
        // не открываем фантомный SSE-поток.
        if (modal.classList.contains("hidden")) { closeStream(); return; }
        closeStream();
        if (restartTimer) { clearTimeout(restartTimer); restartTimer = null; }
        var ids = selectedIDs();
        updateSelInfo();
        if (ids.length === 0) { setConn("Nothing selected", "off"); return; }
        setConn("Connecting...", "wait");
        logBody.scrollTop = 0;
        settleStart();
        var params = ["since=" + encodeURIComponent(sinceSel.value)];
        params.push("lines=" + (linesSel.value === "0" ? "1" : linesSel.value));
        if (!followOn()) params.push("follow=0");
        ids.forEach(function (id) { params.push("sel=" + encodeURIComponent(id)); });
        ES = new EventSource("/logs?" + params.join("&"));
        ES.onopen = function () { streamRetries = 0; setConn("Connected", "on"); };
        ES.onmessage = function (e) {
          var d;
          try { d = JSON.parse(e.data); } catch (_) { return; }
          if (!d) return;
          addLine(d, !!d.error);
        };
        ES.onerror = function () {
          if (ES && ES.readyState === EventSource.CLOSED) setConn("Closed / error", "off");
          else setConn("Network error, reconnecting...", "off");
        };
        ES.addEventListener("done", function () {
          closeStream();
          if (followOn() && !paused && !modal.classList.contains("hidden") && streamRetries < 10) {
            streamRetries++;
            setConn("Stream ended, restarting...", "wait");
            // Без сброса вывода: сервер сам переоткрывает kubectl и возобновляет
            // по --since-time, а этот клиентский перезапуск — лишь запасной путь.
            restartTimer = setTimeout(startStream, 1500);
          } else if (!followOn()) {
            setConn("History loaded", "done");
          } else {
            setConn("Stream finished", "off");
          }
        });
      }

      function escRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }

      function highlightFrag(text, re) {
        var f = document.createDocumentFragment();
        if (!re) { f.appendChild(document.createTextNode(text)); return f; }
        var last = 0, m;
        while ((m = re.exec(text)) !== null) {
          if (m.index > last) f.appendChild(document.createTextNode(text.slice(last, m.index)));
          var mark = document.createElement("mark");
          mark.textContent = m[0];
          f.appendChild(mark);
          last = m.index + m[0].length;
        }
        if (last < text.length) f.appendChild(document.createTextNode(text.slice(last)));
        re.lastIndex = 0;
        return f;
      }

      /* ---------- режимы фильтрации логов ----------
       * Text: весь запрос — простая подстрока.
       * AND: в строке должны быть ВСЕ термы (разделены пробелом).
       * OR: хватает любого терма.
       * Regex: весь запрос — регулярное выражение.
       * Insensitive / Context применяются ко всем режимам.
       */

      function logMode() {
        var r = document.querySelector('input[name="logMode"]:checked');
        return r ? r.value : "text";
      }

      function parseTerms(q, mode) {
        if (mode === "regex" || mode === "text") { var s = q ? q.trim() : ""; return s ? [s] : []; }
        return q.trim().split(/\s+/).filter(Boolean);
      }

      function isValidRegex(q) {
        try { new RegExp(q); return true; } catch (_) { return false; }
      }

      function lineMatches(raw, q, mode, ins) {
        if (!q) return true;
        var terms = parseTerms(q, mode);
        if (!terms.length) return true;
        var hay = ins ? raw.toLowerCase() : raw;
        if (mode === "regex") {
          try { return new RegExp(terms[0], ins ? "i" : "").test(raw); }
          catch (_) { return hay.indexOf(terms[0].toLowerCase()) !== -1; }
        }
        var test = function (t) { var w = ins ? t.toLowerCase() : t; return hay.indexOf(w) !== -1; };
        if (mode === "text") return test(terms[0]);
        if (mode === "or") return terms.some(test);
        return terms.every(test);
      }

      function highlightRe() {
        var q = logFilter.value, ins = insens.checked;
        if (!q) return null;
        var mode = logMode();
        var terms = parseTerms(q, mode);
        if (!terms.length) return null;
        var flags = "g" + (ins ? "i" : "");
        if (mode === "regex") {
          try { return new RegExp(terms[0], flags); }
          catch (_) { return new RegExp(escRe(terms[0]), flags); }
        }
        if (mode === "text") return new RegExp(escRe(terms[0]), flags);
        return new RegExp(terms.map(escRe).join("|"), flags);
      }

      /* ---------- Лёгкая подсветка YAML-синтаксиса ----------
       * Не настоящий парсер: ищем в строке "ключ: значение", окрашиваем ключи,
       * строки, числа, булевы/null, комментарии и структурные символы. Устойчив
       * к битому синтаксису — при любой неоднозначности строка выводится как есть,
       * а исключение вообще гасится в plain-текст. Всегда работает через textContent,
       * так что исходный YAML никогда не попадает в innerHTML.
       */

      function splitYAMLKV(s) {
        var inS = false, inD = false;
        for (var i = 0; i < s.length; i++) {
          var c = s.charAt(i);
          if (c === "'" && !inD) inS = !inS;
          else if (c === '"' && !inS) inD = !inD;
          else if (c === ":" && !inS && !inD) {
            var nx = s.charAt(i + 1);
            if (nx === "" || nx === " " || nx === "\t" || nx === "}" || nx === "]" ||
                nx === '"' || nx === "'" || nx === "{" || nx === "[") {
              return [s.slice(0, i), s.slice(i + 1)];
            }
          }
        }
        return null;
      }

      function yamlValueClass(v) {
        var t = v.trim();
        if (t === "") return null;
        if ((t.charAt(0) === '"' && t.charAt(t.length - 1) === '"') ||
            (t.charAt(0) === "'" && t.charAt(t.length - 1) === "'")) return "y-q";
        if (/^-?\d+(\.\d+)?([eE][+-]?\d+)?$/.test(t)) return "y-n";
        if (/^-?\d+(\.\d+)?[a-zA-Z]+$/.test(t)) return "y-n";
        if (/^(true|false|yes|no|on|off|null|~)$/i.test(t)) return "y-b";
        if (/^[|>][-+]?\d*$/.test(t)) return "y-p";
        if (t.charAt(0) === "&" || t.charAt(0) === "*") return "y-a";
        if (/^[\[\{]/.test(t)) return "y-p";
        return "y-v";
      }

      function yamlPiece(cls, text, needle) {
        var span = document.createElement("span");
        if (cls) span.className = cls;
        if (needle) {
          var re = new RegExp(escRe(needle), "gi");
          var last = 0, m;
          while ((m = re.exec(text)) !== null) {
            if (m.index > last) span.appendChild(document.createTextNode(text.slice(last, m.index)));
            var mk = document.createElement("mark");
            mk.textContent = m[0];
            span.appendChild(mk);
            last = m.index + m[0].length;
          }
          if (last < text.length) span.appendChild(document.createTextNode(text.slice(last)));
        } else {
          span.appendChild(document.createTextNode(text));
        }
        return span;
      }

      function paintYamlLine(frag, line, needle) {
        var add = function (cls, text) {
          if (text === "") return;
          frag.appendChild(yamlPiece(cls, text, needle));
        };
        try {
          var ws = line.match(/^\s*/)[0];
          add(null, ws);
          var rest = line.slice(ws.length);
          if (rest === "") return;
          if (/^-{3}\s*$/.test(rest) || /^\.\.\.\s*$/.test(rest)) { add("y-p", rest); return; }
          if (rest.charAt(0) === "#") { add("y-c", rest); return; }

          var head = rest, dash = null;
          var dm = rest.match(/^-\s+/);
          if (dm) { dash = dm[0]; head = rest.slice(dm[0].length); }
          if (dash) add("y-p", dash);

          if (head === "") return;
          if (head.charAt(0) === "#") { add("y-c", head); return; }

          var kv = splitYAMLKV(head);
          if (!kv) {
            var cl = yamlValueClass(head);
            if (!cl) cl = "y-v";
            add(cl, head);
            return;
          }
          if (kv[0] === "") { add("y-v", head); return; }

          add("y-k", kv[0]);
          add("y-p", ":");

          var val = kv[1];
          var ci = -1;
          for (var i = 0; i < val.length; i++) {
            if (val.charAt(i) === "#" && (i === 0 || /\s/.test(val.charAt(i - 1)))) { ci = i; break; }
          }
          var valText = ci >= 0 ? val.slice(0, ci) : val;
          var cmt = ci >= 0 ? val.slice(ci) : "";
          var vm = valText.match(/^(\s*)(.*)$/);
          add(null, vm[1]);
          if (vm[2] !== "") add(yamlValueClass(vm[2]), vm[2]);
          if (cmt !== "") add("y-c", cmt);
        } catch (e) {
          frag.appendChild(document.createTextNode(line));
        }
      }

      function yamlHighlight(src, needle) {
        var f = document.createDocumentFragment();
        if (!src) return f;
        var lines = src.split("\n");
        for (var i = 0; i < lines.length; i++) {
          paintYamlLine(f, lines[i], needle);
          if (i < lines.length - 1) f.appendChild(document.createTextNode("\n"));
        }
        return f;
      }

      function renderMsg(el, raw) {
        el.textContent = "";
        el.appendChild(highlightFrag(raw, highlightRe()));
      }

      // Подгонка ширины колонок лога под самый длинный контекст/под текущей
      // выборки (в ch, моно-шрифт). Контекст не обрезается зря, как было.
      function trackWidth(col, text) {
        var len = (text || "").length + 1;
        if (col === "ctx") {
          if (len > maxCtxW) { maxCtxW = len; logBody.style.setProperty("--ctxw", maxCtxW + "ch"); }
        } else {
          if (len > maxPodW) { maxPodW = len; logBody.style.setProperty("--podw", maxPodW + "ch"); }
        }
      }

      function addLine(d, isErr) {
        // Защита от дубля на границе переподключения: kubectl --since-time повторно
        // отдаёт строку с последней меткой. Идентичную соседнюю строку пропускаем.
        var key = d.context + "|" + d.namespace + "|" + d.pod + "|" + (d.container || "") +
                  "|" + (d.timestamp || "") + "|" + (d.message || d.error || "");
        if (key === lastKey) return;
        lastKey = key;

        // Ограничение DOM: live-лог не должен расти бесконечно при долгом
        // follow-стриме. Удаляем самые старые строки сверху.
        if (logBody.childElementCount >= MAX_LOG_LINES) {
          var overflow = logBody.childElementCount - MAX_LOG_LINES + 1;
          for (var i = 0; i < overflow; i++) {
            var first = logBody.firstElementChild;
            if (!first) break;
            if (first.classList.contains("logline")) totalLines--;
            if (first.dataset && first.dataset.match === "1") shownLines--;
            logBody.removeChild(first);
          }
        }

        var el = document.createElement("div");
        el.className = "logline" + (isErr ? " logerr" : "");
        el.dataset.raw = d.message || d.error || "";

        var b = document.createElement("span");
        b.className = "lb-badge"; b.textContent = d.context; b.title = (d.context || "") + "/" + (d.namespace || "");
        var t = document.createElement("span");
        t.className = "lb-time"; t.textContent = d.timestamp || "";
        var w = document.createElement("span");
        w.className = "lb-where";
        w.textContent = d.pod + (d.container ? "/" + d.container : "");
        var m = document.createElement("span");
        m.className = "lb-msg";

        trackWidth("ctx", d.context);
        trackWidth("ts", d.timestamp || "");
        trackWidth("pod", w.textContent);

        el.appendChild(b); el.appendChild(w); el.appendChild(t); el.appendChild(m);
        logBody.appendChild(el);
        totalLines++;

        var q = logFilter.value;
        var mode = logMode();
        var ins = insens.checked;
        var ctx = ctxChk.checked;
        var ok = lineMatches(el.dataset.raw, q, mode, ins);
        el.dataset.match = ok ? "1" : "0";

        var shown = ok;
        if (!shown && ctx) {
          // Контекстный вывод (grep -B 1): предыдущая строка — совпадение.
          // Следующая разкроет себя сама, когда придёт.
          var prev = el.previousElementSibling;
          if (prev && prev.classList.contains("logline") && prev.dataset.match === "1") {
            shown = true;
            el.classList.add("ctx");
          }
        }
        if (shown) {
          shownLines++;
          renderMsg(m, el.dataset.raw);
        } else {
          el.classList.add("hide");
        }

        // Текущая строка — совпадение: скрытая несовпавшая предыдущая становится
        // контекстной (grep -A 1) и разворачивается. Контекст не размножается дальше,
        // т.к. раскрытие затрагивает только соседей настоящего совпадения.
        if (ctx && ok) {
          var p = el.previousElementSibling;
          if (p && p.classList.contains("logline") && p.dataset.match === "0" &&
              p.classList.contains("hide")) {
            p.classList.remove("hide");
            p.classList.add("ctx");
            renderMsg(p.querySelector(".lb-msg"), p.dataset.raw);
            shownLines++;
          }
        }

        el.addEventListener("click", function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(d.message || d.error || "");
          }
        });

        lineCountEl.textContent = shownLines + " / " + totalLines;
        if (autoScrollOn() && !settling) logBody.scrollTop = logBody.scrollHeight;
      }

      function applyLogFilter() {
        var q = logFilter.value;
        var mode = logMode();
        var ins = insens.checked;
        var ctx = ctxChk.checked;
        var els = logBody.querySelectorAll(".logline");
        var i, n = els.length;
        var match = new Array(n);
        for (i = 0; i < n; i++) {
          match[i] = lineMatches(els[i].dataset.raw, q, mode, ins);
          els[i].dataset.match = match[i] ? "1" : "0";
          els[i].classList.remove("ctx");
        }
        shownLines = 0;
        for (i = 0; i < n; i++) {
          var ok = match[i] || (ctx && ((i > 0 && match[i - 1]) || (i < n - 1 && match[i + 1])));
          els[i].classList.toggle("hide", !ok);
          if (ok) {
            shownLines++;
            els[i].classList.toggle("ctx", !match[i]);
            renderMsg(els[i].querySelector(".lb-msg"), els[i].dataset.raw);
          } else {
            els[i].querySelector(".lb-msg").textContent = "";
          }
        }
        lineCountEl.textContent = shownLines + " / " + totalLines;
        logFilter.classList.toggle("re", mode === "regex" && q !== "" && !isValidRegex(q));
      }
      logFilter.addEventListener("input", applyLogFilter);
      insens.addEventListener("change", applyLogFilter);
      ctxChk.addEventListener("change", applyLogFilter);
      document.querySelectorAll('input[name="logMode"]').forEach(function (r) {
        r.addEventListener("change", applyLogFilter);
      });

      autoScroll.addEventListener("click", function () {
        autoScroll.classList.toggle("on");
        if (autoScrollOn()) logBody.scrollTop = logBody.scrollHeight;
      });
      logBody.addEventListener("scroll", function () {
        var near = logBody.scrollHeight - logBody.scrollTop - logBody.clientHeight < 60;
        if (!near && autoScrollOn()) autoScroll.classList.remove("on");
      });

      function restartIfStreaming() {
        if (!paused && !modal.classList.contains("hidden")) {
          clearLog();
          startStream();
        }
      }
      sinceSel.addEventListener("change", restartIfStreaming);
      followChk.addEventListener("click", function () {
        followChk.classList.toggle("on");
        if (followOn()) {
          restartIfStreaming();
        } else {
          closeStream();
          setConn("Stopped", "off");
        }
      });
      linesSel.addEventListener("change", restartIfStreaming);

      btnPause.addEventListener("click", function () {
        if (paused) {
          paused = false; btnPause.textContent = "Pause";
          btnPause.classList.remove("on");
          startStream();
        } else {
          paused = true; btnPause.textContent = "Resume";
          btnPause.classList.add("on");
          closeStream();
          setConn("Paused", "wait");
        }
      });

      wrapChk.addEventListener("change", function () {
        logBody.classList.toggle("no-wrap", !wrapChk.checked);
      });
      tsChk.addEventListener("change", function () {
        logBody.classList.toggle("no-ts", !tsChk.checked);
      });

      $("#btnClear").addEventListener("click", function () {
        logBody.innerHTML = "";
        totalLines = 0; shownLines = 0;
        lastKey = null;
        lineCountEl.textContent = "0";
        if (!paused) startStream();
      });

      $("#btnDownload").addEventListener("click", function () {
        var lines = [];
        logBody.querySelectorAll(".logline:not(.hide)").forEach(function (el) {
          var parts = [];
          ["lb-badge", "lb-where", "lb-time", "lb-msg"].forEach(function (c) {
            var q = el.querySelector("." + c);
            if (q && q.textContent) parts.push(q.textContent);
          });
          lines.push(parts.join(" "));
        });
        if (lines.length === 0) return;
        var blob = new Blob([lines.join("\n")], { type: "text/plain;charset=utf-8" });
        var a = document.createElement("a");
        var f = new Date().toISOString().slice(0, 19).replace(/[:T]/g, "-");
        a.href = URL.createObjectURL(blob);
        a.download = "crossboard-" + f + ".log";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(a.href);
      });

      function closeModal() {
        closeStream();
        if (restartTimer) { clearTimeout(restartTimer); restartTimer = null; }
        modal.classList.add("hidden");
        clearLog();
      }
      $("#btnClose").addEventListener("click", closeModal);

      /* ================= resource browser ================= */

      // Динамический фильтр по конкретному Kind (не по типу-категории): чипы
      // строятся из того, что реально встретилось в текущем списке ресурсов.
      var KIND_LABELS = {
        pod: "Pod", deployment: "Deployment", statefulset: "StatefulSet",
        daemonset: "DaemonSet", replicaset: "ReplicaSet", job: "Job", cronjob: "CronJob",
        service: "Service", ingress: "Ingress", networkpolicy: "NetworkPolicy",
        configmap: "ConfigMap", secret: "Secret",
        persistentvolumeclaim: "PersistentVolumeClaim", persistentvolume: "PersistentVolume",
        serviceaccount: "ServiceAccount", role: "Role", rolebinding: "RoleBinding",
        clusterrole: "ClusterRole", clusterrolebinding: "ClusterRoleBinding",
        namespace: "Namespace", node: "Node", storageclass: "StorageClass",
        horizontalpodautoscaler: "HorizontalPodAutoscaler", poddisruptionbudget: "PodDisruptionBudget",
        endpoints: "Endpoints", endpointslice: "EndpointSlice",
        gateway: "Gateway", virtualservice: "VirtualService", destinationrule: "DestinationRule",
        certificate: "Certificate", issuer: "Issuer", clusterissuer: "ClusterIssuer"
      };
      function kindLabel(k) { return KIND_LABELS[k] || (k.charAt(0).toUpperCase() + k.slice(1)); }
      var relState = { tr: null, items: [], kinds: {}, ctx: "", loaded: null, yaml: "", needle: "" };

      function normStr(s) { return (s || "").toLowerCase(); }

      function labelPairs(l, fallback) {
        var text = "";
        if (l && typeof l !== "string") {
          var ks = Object.keys(l).sort();
          if (ks.length) text = ks.map(function (k) { return k + "=" + l[k]; }).join(", ");
        }
        if (!text) text = (typeof l === "string") ? (l || "") : (fallback || "");
        return text.split(",").map(function (s) { return s.trim(); }).filter(Boolean);
      }

      function renderSpecMeta(tr, d) {
        specMeta.innerHTML = "";
        var lbl = document.createElement("span");
        lbl.className = "labs";
        var b = document.createElement("b");
        b.textContent = "Shared labels ";
        lbl.appendChild(b);

        var pairs = labelPairs(d.labels, tr.dataset.labels);
        if (!pairs.length) {
          var dash = document.createElement("code");
          dash.textContent = "\u2014";
          lbl.appendChild(dash);
        }
        pairs.forEach(function (pair) {
          var chip = document.createElement("span");
          chip.className = "lchip";
          chip.title = pair;
          var eq = pair.indexOf("=");
          var lk = document.createElement("span");
          lk.className = "lk";
          if (eq === -1) { lk.textContent = pair; }
          else {
            lk.textContent = pair.slice(0, eq);
            var eqEl = document.createElement("span");
            eqEl.className = "eq"; eqEl.textContent = "=";
            var lv = document.createElement("span");
            lv.className = "lv"; lv.textContent = pair.slice(eq + 1);
            chip.appendChild(lk); chip.appendChild(eqEl); chip.appendChild(lv);
          }
          if (eq === -1) chip.appendChild(lk);
          lbl.appendChild(chip);
        });

        specMeta.appendChild(lbl);
        if (d.error) {
          var e = document.createElement("span");
          e.className = "labs";
          e.style.color = "var(--red)";
          e.textContent = d.error;
          specMeta.appendChild(e);
        }
      }

      function matchRel(it, q) {
        if (q && normStr(it.kind + " " + it.name).indexOf(q) === -1) return false;
        return true;
      }

      function buildSpecChips() {
        specChips.innerHTML = "";
        var q = normStr(specFilter.value);
        var counts = {};
        relState.items.forEach(function (it) {
          if (!matchRel(it, q)) return;
          counts[it.kind] = (counts[it.kind] || 0) + 1;
        });
        Object.keys(counts).sort(function (a, b) {
          var la = kindLabel(a), lb = kindLabel(b);
          return la < lb ? -1 : la > lb ? 1 : 0;
        }).forEach(function (k) {
          var chip = document.createElement("button");
          chip.type = "button";
          chip.className = "chip" + (relState.kinds[k] ? " on" : "");
          var lbl = document.createElement("span");
          lbl.textContent = kindLabel(k);
          var n = document.createElement("span");
          n.className = "n";
          n.textContent = counts[k];
          chip.appendChild(lbl); chip.appendChild(n);
          chip.addEventListener("click", function () {
            if (relState.kinds[k]) delete relState.kinds[k];
            else relState.kinds[k] = true;
            renderSpecList();
          });
          specChips.appendChild(chip);
        });
      }

      function renderSpecList() {
        buildSpecChips();
        var q = normStr(specFilter.value);
        specItems.innerHTML = "";
        var kinds = Object.keys(relState.kinds);
        var groups = {}, order = [];
        relState.items.forEach(function (it) {
          if (kinds.length && !relState.kinds[it.kind]) return;
          if (!matchRel(it, q)) return;
          if (!groups[it.kind]) { groups[it.kind] = []; order.push(it.kind); }
          groups[it.kind].push(it);
        });
        order.sort(function (a, b) {
          var la = kindLabel(a), lb = kindLabel(b);
          return la < lb ? -1 : la > lb ? 1 : 0;
        });
        var shown = 0;
        order.forEach(function (k) {
          var list = groups[k];
          var catEl = document.createElement("div");
          catEl.className = "spec-cat";
          catEl.textContent = kindLabel(k) + " (" + list.length + ")";
          specItems.appendChild(catEl);
          list.forEach(function (it) {
            var b = document.createElement("button");
            b.type = "button";
            b.className = "spec-item";
            if (relState.loaded && relState.loaded.kind === it.kind && relState.loaded.name === it.name) {
              b.classList.add("active");
            }
            b.dataset.k = it.kind; b.dataset.n = it.name;
            var k = document.createElement("span");
            k.className = "spec-kind"; k.textContent = it.kind;
            var nm = document.createElement("span");
            nm.className = "nm"; nm.textContent = it.name;
            b.appendChild(k);
            if (it.ns) {
              var sn = document.createElement("span");
              sn.className = "sns"; sn.textContent = it.ns + "/";
              b.appendChild(sn);
            }
            b.appendChild(nm);
            if (it.ctx) {
              var cy = document.createElement("span");
              cy.className = "scx"; cy.textContent = it.ctx;
              b.appendChild(cy);
            }
            if (it.reason) {
              var rs = document.createElement("span");
              rs.className = "reason"; rs.textContent = it.reason;
              b.appendChild(rs);
            }
            if (it.age) {
              var ag = document.createElement("span");
              ag.className = "age";
              ag.textContent = it.age;
              ag.title = "created " + (it.created || it.age);
              b.appendChild(ag);
            }
            b.addEventListener("click", function () { loadSpec(it); });
            specItems.appendChild(b);
            shown++;
          });
        });
        if (!shown) {
          var empty = document.createElement("div");
          empty.className = "spec-cat error";
          empty.textContent = "No matching resources.";
          specItems.appendChild(empty);
        }
      }

      function renderSpecBody() {
        specBody.innerHTML = "";
        specBody.appendChild(yamlHighlight(relState.yaml || "", relState.needle.length >= 2 ? relState.needle : ""));
        updateSearchStat();
      }

      function countMatches(hay, nd) {
        if (!nd || !hay) return 0;
        var lh = hay.toLowerCase();
        var c = 0, i = 0;
        while ((i = lh.indexOf(nd, i)) !== -1) { c++; i += nd.length; }
        return c;
      }

      function updateSearchStat() {
        var el = document.getElementById("searchStat");
        if (!el) return;
        el.className = "search-stat";
        var q = normStr(specSearch && specSearch.value);
        if (q.length < 2) { el.textContent = ""; return; }
        var n = countMatches(relState.yaml || "", q);
        el.textContent = n + (n === 1 ? " match" : " matches");
        if (n > 0) el.className = "search-stat hit";
      }

      function resetSpecModal() {
        relState.kinds = {};
        relState.loaded = null;
        relState.yaml = "";
        relState.needle = "";
        specFilter.value = "";
        specSearch.value = "";
        var st = document.getElementById("searchStat");
        if (st) { st.textContent = ""; st.className = "search-stat"; }
        specChips.innerHTML = "";
        specItems.innerHTML = "";
        specMeta.innerHTML = "";
      }

      function enterSpec(items, errorText, defaultKind) {
        if (!items || !items.length) {
          var msg = errorText || "No related resources found.";
          var empty = document.createElement("div");
          empty.className = "spec-cat error";
          empty.textContent = msg;
          specItems.appendChild(empty);
          specBody.textContent = msg + " Check permissions on the cluster.";
          specBody.className = "spec-body error";
          return;
        }
        relState.items = items;
        // Клик по строке пода — показываем манифест самого пода; клик по контейнеру
        // (или список карточки) — его workload-цепочку (deployment и т.п.).
        var dflt = items.filter(function (it) { return it.kind === defaultKind; })[0] || items[0];
        relState.loaded = { kind: dflt.kind, name: dflt.name };
        renderSpecList();
        loadSpec(dflt);
      }

      function openSpec(tr, viaCont) {
        specTitle.textContent = tr.dataset.pod || "";
        relState.tr = tr;
        relState.items = [];
        resetSpecModal();
        specModal.classList.remove("hidden");
        specBody.textContent = "Loading...";
        specBody.className = "spec-body";

        var q = "ctx=" + encodeURIComponent(tr.dataset.ctx) +
                "&ns=" + encodeURIComponent(tr.dataset.ns) +
                "&pod=" + encodeURIComponent(tr.dataset.pod);
        if (tr.dataset.node) q += "&node=" + encodeURIComponent(tr.dataset.node);

        fetch("/api/related?" + q)
          .then(function (r) { return r.json(); })
          .then(function (d) {
            renderSpecMeta(tr, d);
            enterSpec(d.items, d.error, viaCont ? "deployment" : "pod");
          })
          .catch(function (err) {
            specBody.textContent = "Failed to load resource list: " + err;
            specBody.className = "spec-body error";
          });
      }

      var CARD_SCOPE_TITLES = {
        ctx: "Cluster Configs", ns: "Namespaces", nodes: "Nodes",
        svc: "Networks (Service, Ingress, Endpoints, NetworkPolicy)",
        jobs: "Jobs and CronJobs", configs: "Configs (ConfigMap, Secret) and RBAC (ServiceAccount, Role, RoleBinding, ClusterRole, ClusterRoleBinding)",
        workloads: "Workloads (Deployments, ReplicaSets, StatefulSets, DaemonSets)",
        pods: "Pods", pvc: "Volumes (PersistentVolumeClaim, PersistentVolume, StorageClass)", events: "Events",
        charts: "Helm Charts", limits: "Pods with limits"
      };

      function cardTitle(scope) { return CARD_SCOPE_TITLES[scope] || "Resources"; }

      function sortByCtxNsName(arr) {
        arr.sort(function (a, b) {
          var cmp = (a.ctx || "").localeCompare(b.ctx || "");
          if (cmp) return cmp;
          cmp = (a.ns || "").localeCompare(b.ns || "");
          if (cmp) return cmp;
          return (a.name || "").localeCompare(b.name || "");
        });
        return arr;
      }

      // Список подов собирается из уже загруженных данных страницы (без kubectl).
      function cardItemsFromData() {
        var rows = (window.__crossboardData && window.__crossboardData.pods) || [];
        var map = {}, order = [];
        rows.forEach(function (p) {
          var key = p.context + "|" + p.namespace + "|" + p.name;
          if (!map[key]) { map[key] = p; order.push(key); }
        });
        return sortByCtxNsName(order.map(function (k) {
          var p = map[k];
          return { kind: "pod", name: p.name,
                   reason: p.phase || "", age: p.age || "",
                   ctx: p.context, ns: p.namespace };
        }));
      }

      // Список манифестов (под → контейнер), в которых прописаны CPU/Memory hard limits.
      // Считается из уже загруженных данных страницы: суммирует лимиты контейнеров пода.
      function limitsItemsFromData() {
        var rows = (window.__crossboardData && window.__crossboardData.pods) || [];
        var map = {}, order = [];
        rows.forEach(function (p) {
          var cpu = parseCpuMilli(p.cpulim);
          var mem = parseMemKi(p.memlim);
          if (!cpu && !mem) return;
          var key = p.context + "|" + p.namespace + "|" + p.name;
          if (!map[key]) {
            map[key] = { name: p.name, cpu: 0, mem: 0, ctx: p.context, ns: p.namespace, age: p.age || "" };
            order.push(key);
          }
          map[key].cpu += cpu; map[key].mem += mem;
        });
        return sortByCtxNsName(order.map(function (k) {
          var p = map[k];
          return { kind: "pod", name: p.name,
                   reason: (p.cpu ? "CPU " + fmtCore(p.cpu) : "") +
                           (p.cpu && p.mem ? " · " : "") +
                           (p.mem ? "MEM " + fmtGiB(p.mem) + " GiB" : ""),
                   age: p.age || "", ctx: p.ctx, ns: p.ns };
        }));
      }

      function openSpecList(scope) {
        if (scope === "events") { openEvents(); return; }
        relState.tr = { dataset: {} };
        relState.items = [];
        specTitle.textContent = cardTitle(scope);
        resetSpecModal();
        specModal.classList.remove("hidden");
        if (scope === "pods") {
          var items = cardItemsFromData();
          if (!items.length) {
            specBody.textContent = "Loading...";
            specBody.className = "spec-body";
            fetch("/api/pods")
              .then(function (r) { return r.json(); })
              .then(function (d) {
                window.__crossboardData = d;
                enterSpec(cardItemsFromData(), "No pod data loaded yet. Refresh the page.", "pod");
              })
              .catch(function (err) {
                specBody.textContent = "Failed to load pod data: " + err;
                specBody.className = "spec-body error";
              });
            return;
          }
          enterSpec(items, "No pod data loaded yet. Refresh the page.", "pod");
          return;
        }
        if (scope === "limits") {
          var limItems = limitsItemsFromData();
          if (!limItems.length) {
            specBody.textContent = "Loading...";
            specBody.className = "spec-body";
            fetch("/api/pods")
              .then(function (r) { return r.json(); })
              .then(function (d) {
                window.__crossboardData = d;
                enterSpec(limitsItemsFromData(), "No pods with CPU/memory hard limits. Refresh the page.", "pod");
              })
              .catch(function (err) {
                specBody.textContent = "Failed to load pod data: " + err;
                specBody.className = "spec-body error";
              });
            return;
          }
          enterSpec(limItems, "No pods with CPU/memory hard limits.", "pod");
          return;
        }
        specBody.textContent = "Loading...";
        specBody.className = "spec-body";
        fetch("/api/overview?scope=" + encodeURIComponent(scope))
          .then(function (r) { return r.json(); })
          .then(function (d) { enterSpec(d.items, d.error, ""); })
          .catch(function (err) {
            specBody.textContent = "Failed to load resource list: " + err;
            specBody.className = "spec-body error";
          });
      }

      function loadSpec(it) {
        relState.loaded = { kind: it.kind, name: it.name };
        specItems.querySelectorAll(".spec-item").forEach(function (el) {
          el.classList.toggle("active", el.dataset.k === it.kind && el.dataset.n === it.name);
        });
        specBody.textContent = "Loading " + it.kind + "/" + it.name + " ...";
        specBody.className = "spec-body";
        var tr = relState.tr || { dataset: {} };
        var c = (it.ctx || tr.dataset.ctx || "");
        var n = (it.ns || tr.dataset.ns || "");
        var q = "ctx=" + encodeURIComponent(c) +
                "&ns=" + encodeURIComponent(n) +
                "&kind=" + encodeURIComponent(it.kind) +
                "&name=" + encodeURIComponent(it.name);
        fetch("/api/object?" + q)
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.error) {
              specBody.textContent = d.error;
              specBody.className = "spec-body error";
            } else {
              relState.yaml = d.yaml;
              renderSpecBody();
              specBody.className = "spec-body";
            }
          })
          .catch(function (err) {
            specBody.textContent = "Failed to load spec: " + err;
            specBody.className = "spec-body error";
          });
      }

      function closeSpec() {
        specModal.classList.add("hidden");
        specItems.innerHTML = "";
        specChips.innerHTML = "";
        specMeta.innerHTML = "";
        specBody.textContent = "Loading...";
        specBody.className = "spec-body";
        specTitle.textContent = "";
        relState = { tr: null, items: [], kinds: {}, loaded: null, yaml: "", needle: "" };
      }
      $("#btnSpecClose").addEventListener("click", closeSpec);

      specFilter.addEventListener("input", renderSpecList);

      /* ================= events modal ================= */
      var evModal = $("#eventsModal"), evBodyEl = $("#eventsBody");
      var evTypeSeg = $("#evTypeSeg"), evFilter = $("#evFilter"), evStat = $("#evStat");
      var evCtx = $("#evCtx"), evKinds = $("#evKinds");
      var evWrap = $("#evWrap"), evScroll = $("#evScroll");
      var evState = { items: [], kinds: {} };

      function evTypeValue() {
        var r = evTypeSeg ? evTypeSeg.querySelector('input:checked') : null;
        return r ? r.value : "";
      }

      function evObjKind(it) {
        var p = String(it.name || "").split("/");
        return p.length >= 3 ? p[1] : "-";
      }

      function openEvents() {
        evBodyEl.innerHTML = '<tr><td colspan="7" class="empty">Loading...</td></tr>';
        var allBtn = evTypeSeg && evTypeSeg.querySelector('input[value=""]');
        if (allBtn) allBtn.checked = true;
        evCtx.value = "";
        evFilter.value = "";
        evState.kinds = {};
        if (evStat) { evStat.textContent = ""; evStat.className = "count"; }
        evModal.classList.remove("hidden");
        fetch("/api/overview?scope=events")
          .then(function (r) { return r.json(); })
          .then(function (d) {
            evState.items = d.items || [];
            fillEvCtx();
            renderEvKinds();
            renderEvents();
          })
          .catch(function (err) {
            evBodyEl.innerHTML = '<tr><td colspan="7" class="empty">Failed to load events: ' + err + '</td></tr>';
          });
      }

      function fillEvCtx() {
        var seen = {}, list = [];
        evState.items.forEach(function (it) {
          if (it.ctx && !seen[it.ctx]) { seen[it.ctx] = 1; list.push(it.ctx); }
        });
        list.sort();
        fillSelect(evCtx, list, "Cluster: all");
      }

      function renderEvKinds() {
        evKinds.innerHTML = "";
        var counts = {};
        evState.items.forEach(function (it) {
          var k = evObjKind(it);
          counts[k] = (counts[k] || 0) + 1;
        });
        Object.keys(counts).sort(function (a, b) { return a < b ? -1 : a > b ? 1 : 0; }).forEach(function (k) {
          var chip = document.createElement("button");
          chip.type = "button";
          chip.className = "chip" + (evState.kinds[k] ? " on" : "");
          var lbl = document.createElement("span");
          lbl.textContent = k;
          var n = document.createElement("span");
          n.className = "n";
          n.textContent = counts[k];
          chip.appendChild(lbl); chip.appendChild(n);
          chip.addEventListener("click", function () {
            if (evState.kinds[k]) delete evState.kinds[k];
            else evState.kinds[k] = true;
            renderEvKinds();
            renderEvents();
          });
          evKinds.appendChild(chip);
        });
      }

      function renderEvents() {
        var t = evTypeValue(), q = normStr(evFilter.value), c = evCtx.value;
        var kinds = Object.keys(evState.kinds);
        var items = evState.items.filter(function (it) {
          if (t && it.type !== t) return false;
          if (c && it.ctx !== c) return false;
          if (kinds.length && !evState.kinds[evObjKind(it)]) return false;
          if (q) {
            var hay = normStr(it.message || "");
            if (hay.indexOf(q) === -1) return false;
          }
          return true;
        });
        if (evStat) evStat.textContent = items.length + " of " + evState.items.length;
        if (!items.length) {
          evBodyEl.innerHTML = '<tr><td colspan="7" class="empty">No events found for the given filters.</td></tr>';
          return;
        }
        var frag = document.createDocumentFragment();
        items.forEach(function (it) {
          var tr = document.createElement("tr");
          var td = function (cls, txt, title) {
            var x = document.createElement("td");
            if (cls) x.className = cls;
            if (title) x.title = title;
            x.textContent = txt;
            return x;
          };
          var typeBadge = document.createElement("span");
          typeBadge.className = "badge " + (it.type === "Warning" ? "warn" : "blue");
          typeBadge.textContent = it.type || "-";
          var tdt = td(null, null);
          tdt.appendChild(typeBadge);
          tr.appendChild(td("age", it.age || "-"));
          tr.appendChild(td("ctx", it.ctx || "-"));
          tr.appendChild(td("ns", it.ns || "-"));
          tr.appendChild(td("name", it.name || "-", it.name));
          tr.appendChild(tdt);
          tr.appendChild(td("reason", it.reason || "-", it.reason));
          var msg = td("msg", it.message || "-", it.message);
          msg.title = it.message || "";
          tr.appendChild(msg);
          frag.appendChild(tr);
        });
        evBodyEl.innerHTML = "";
        evBodyEl.appendChild(frag);
      }

      function closeEvents() {
        evModal.classList.add("hidden");
        evState.items = [];
        evState.kinds = {};
      }
      $("#btnEvClose").addEventListener("click", closeEvents);
      evTypeSeg.addEventListener("change", renderEvents);
      evCtx.addEventListener("change", renderEvents);
      evFilter.addEventListener("input", renderEvents);
      evWrap.addEventListener("change", function () {
        if (evScroll) evScroll.classList.toggle("no-wrap", !evWrap.checked);
      });

      // Поиск по содержимому текущего манифеста — чисто на клиенте (данные уже
      // загружены в relState.yaml), без единого лишнего вызова kubectl.
      var specSearchTimer = null;
      specSearch.addEventListener("input", function () {
        if (specSearchTimer) clearTimeout(specSearchTimer);
        specSearchTimer = setTimeout(function () {
          relState.needle = normStr(specSearch.value);
          renderSpecBody();
        }, 200);
      });

      tbody.addEventListener("click", function (e) {
        if (e.target.closest && e.target.closest("input,select,button,a,label")) return;
        var tr = e.target.closest ? e.target.closest("tr") : null;
        if (!tr || !tr.dataset || !tr.dataset.ix) return;
        var viaCont = !!(e.target.closest && e.target.closest("td.cont"));
        openSpec(tr, viaCont);
      });

      function bindCards(host) {
        host.addEventListener("click", function (e) {
          if (e.target.closest && e.target.closest("input,select,button,a")) return;
          var el = e.target.closest ? e.target.closest(".card") : null;
          if (el && el.dataset && el.dataset.scope) openSpecList(el.dataset.scope);
        });
      }
      bindCards($("#cards"));
      bindCards($("#cards2"));

      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        if (!modal.classList.contains("hidden")) { closeModal(); return; }
        if (!specModal.classList.contains("hidden")) closeSpec();
        if (typeof closeEvents === "function" && !evModal.classList.contains("hidden")) closeEvents();
      });
      modal.addEventListener("click", function (e) {
        if (e.target === modal) closeModal();
      });
      specModal.addEventListener("click", function (e) {
        if (e.target === specModal) closeSpec();
      });
      if (evModal) evModal.addEventListener("click", function (e) {
        if (e.target === evModal) closeEvents();
      });
      })();
    </script>

    {{end}}
  </body>
</html>
